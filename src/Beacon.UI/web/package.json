{
  "name": "beacon-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK_API=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "dotnet nswag run nswag.config.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@microsoft/signalr": "^10.0.11",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.105.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.66.0",
    "marked": "^18.2.0",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "//overrides": "The monaco-editor override covers its npm dependency on dompurify only. monaco-editor also ships its own copy of DOMPurify inside esm/vs/base/browser/dompurify/ (3.2.7 in 0.55.1), which Monaco's editor imports directly and no override can replace: that copy is patched only by a monaco-editor release that vendors a newer one.",
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    },
    "katex": "^0.18.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
