{
  "name": "beacon-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK_API=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "dotnet nswag run nswag.config.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@microsoft/signalr": "^8.0.7",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.3",
    "mermaid": "^11.14.0",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^7.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "msw": "^2.14.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^5.0.5"
  },
  "//overrides": "The monaco-editor override covers its npm dependency on dompurify only. monaco-editor also ships its own copy of DOMPurify inside esm/vs/base/browser/dompurify/ (3.2.7 in 0.55.1), which Monaco's editor imports directly and no override can replace: that copy is patched only by a monaco-editor release that vendors a newer one.",
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    },
    "katex": "^0.16.47"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
