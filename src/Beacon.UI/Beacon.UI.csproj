<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Stays at the root. The /beacon mount comes from the build output living in a
             wwwroot/beacon FOLDER, not from this property: the vite bundle is packed as ordinary
             content (content/wwwroot/**), which a PackageReference copies to the consuming app's
             wwwroot verbatim, so StaticWebAssetBasePath never applies to it. Setting it to
             /beacon relabelled URLs the ProjectReference path honours while leaving the packaged
             files at the root — the sample app worked and every consumer 404'd on its assets. -->
        <StaticWebAssetBasePath>/</StaticWebAssetBasePath>

        <!-- NuGet packaging metadata. Consumers reference this package to get the React SPA + MapBeaconUi().
             PackageId comes from Directory.Build.props (Moberg.Beacon.UI) — do not set it here. -->
        <IsPackable>true</IsPackable>
        <Description>Beacon React SPA packaged as an ASP.NET Core Razor Class Library. Adds `app.MapBeaconUi()` to host the UI from any .NET 10 web app.</Description>
        <Authors>Moberg</Authors>

        <!-- React/Vite build wiring -->
        <ReactAppDir>$(MSBuildProjectDirectory)/web</ReactAppDir>
        <ReactBuildOutputDir>$(MSBuildProjectDirectory)/wwwroot/beacon</ReactBuildOutputDir>
        <BuildReactInDebug Condition="'$(BuildReactInDebug)' == ''">false</BuildReactInDebug>
        <ShouldBuildReact Condition="'$(Configuration)' == 'Release' Or '$(BuildReactInDebug)' == 'true'">true</ShouldBuildReact>
        <ShouldBuildReact Condition="'$(ShouldBuildReact)' == ''">false</ShouldBuildReact>
        <!-- A no-build pack (dotnet pack with NoBuild=true) still runs AssignTargetPaths, which would
             re-trigger BuildReactApp below. Vite emits content-hashed filenames and clears wwwroot,
             so that second build leaves the static web asset manifest (written by the preceding
             dotnet build) pointing at deleted hashes, and pack fails with NU5019. Reuse the
             existing wwwroot output instead. -->
        <ShouldBuildReact Condition="'$(NoBuild)' == 'true'">false</ShouldBuildReact>

        <!-- Exclude the React source tree from the C# compile + RCL content scan.
             Only wwwroot (vite build output) ships as static web assets. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);web/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <Target Name="EnsureReactDependencies"
            Condition="'$(ShouldBuildReact)' == 'true' And !Exists('$(ReactAppDir)/node_modules')">
        <Message Importance="high" Text="Beacon.UI: installing npm dependencies in $(ReactAppDir)..." />
        <Exec Command="npm ci" WorkingDirectory="$(ReactAppDir)" />
    </Target>

    <Target Name="BuildReactApp"
            BeforeTargets="AssignTargetPaths;ResolveStaticWebAssetsConfiguration"
            Condition="'$(ShouldBuildReact)' == 'true'"
            DependsOnTargets="EnsureReactDependencies">
        <Message Importance="high" Text="Beacon.UI: building React app (configuration $(Configuration))..." />
        <Exec Command="npm run build" WorkingDirectory="$(ReactAppDir)" />
    </Target>

    <!-- Register the bundle vite just produced as Content, so the Razor SDK turns it into static
         web assets and packs it under staticwebassets/.

         Without this the files are invisible to the SDK: it globs wwwroot/** at EVALUATION time,
         and BuildReactApp does not write them until the build is already running. They were then
         swept up only by the pack-time Content glob and shipped under content/ + contentFiles/ —
         the packages.config-era layout, which an SDK-style PackageReference never copies. The
         result was a package whose 498 bundle files no consumer could serve: the asset manifest
         pointed at <consumer>/wwwroot/beacon/* and nothing ever wrote those files, so every
         request 404'd while the sample project (a ProjectReference, resolved from disk) worked.

         Runs after the bundle exists and before AssignTargetPaths consumes the item list. The
         condition is on the output directory rather than ShouldBuildReact because the release
         pipeline packs with NoBuild set: BuildReactApp is skipped there, so an AfterTargets hook
         alone would never fire and pack would fall back to the broken content/ layout. -->
    <Target Name="IncludeReactBuildOutput"
            AfterTargets="BuildReactApp"
            BeforeTargets="AssignTargetPaths;ResolveStaticWebAssetsConfiguration"
            Condition="Exists('$(ReactBuildOutputDir)')">
        <ItemGroup>
            <!-- Drop the evaluation-time snapshot first: on an incremental rebuild it still names
                 the previous bundle's content-hashed filenames, which vite has just deleted, and
                 DefineStaticWebAssets fails with "No file exists for the asset". -->
            <Content Remove="$(ReactBuildOutputDir)/**" />
            <Content Include="$(ReactBuildOutputDir)/**" />
        </ItemGroup>
    </Target>

    <Target Name="CleanReactBuild" AfterTargets="Clean">
        <RemoveDir Directories="$(ReactBuildOutputDir)" Condition="Exists('$(ReactBuildOutputDir)')" />
    </Target>

</Project>
