{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Beacon": {
    // Beacon:EncryptionKey is required and never committed: base64 of at least 32 random bytes, for example
    //   dotnet user-secrets --project Beacon.SampleProject set "Beacon:EncryptionKey" "$(openssl rand -base64 32)"
    // or the Beacon__EncryptionKey environment variable. Values encrypted with a key you replace stay readable while that
    // key is listed in "PreviousEncryptionKeys".
    "BaseUrl": "https://localhost:7187/beacon",
    // Data Protection application name (AddBeaconDataProtection); required outside Development, one per deployment.
    "DataProtection": {
      "ApplicationName": ""
    },
    // Public origin used in the MCP discovery documents (/.well-known/*) and the 401
    // resource_metadata challenge. Leave empty to derive from the incoming request.
    "PublicBaseUrl": "",
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": []
    },
     "Authentication": {
       // Beacon's API keys, bearer tokens and sign-in cookie authenticate /beacon and these paths only. The Warp
       // dashboard admits Beacon admins, so it needs the Beacon session.
       "AdditionalPaths": ["/warp"],
       "Oidc": {
         "Enabled": false,
         "Authority": "https://login.microsoftonline.com/{YOUR_TENANT_ID}/v2.0",
         "ClientId": "{YOUR_CLIENT_ID}",
         "ClientSecret": "{YOUR_CLIENT_SECRET}",
         "CallbackPath": "/signin-oidc",
         "Scopes": ["openid", "profile", "email"],
         // Who may sign in: only users of these tenants (tid). Startup fails with SSO enabled and no tenant listed.
         // Use "AllowAnyTenant": true only for an identity provider that issues no tid claim.
         "AllowedTenants": ["{YOUR_TENANT_ID}"],
         // Entra B2B guests are refused (acct=1 / foreign idp). Optionally require an app role or group as well.
         "BlockGuests": true,
         "RequiredRoles": [],
         "RequiredGroups": [],
         // No DefaultRoleName: first-time SSO users get no role until an admin assigns one.
         // RequireMfa: refuse a sign-in whose ID token shows no multi-factor authentication (amr "mfa", or an acr listed
         // in AcceptedAcrValues).
         "RequireMfa": false,
         "AcceptedAcrValues": [],
         "DisplayName": "Microsoft",
         "McpJwksEndpoint": "https://login.microsoftonline.com/{YOUR_TENANT_ID}/discovery/v2.0/keys"
       }
     },
    // Password sign-in through the login form. With SSO, set Enabled to false (people then sign in through the identity
    // provider) and keep one emergency account, typically the super admin, in BreakGlassUserNames (at most 3).
    "UserManagement": {
      "LocalLogin": {
        "Enabled": true,
        "BreakGlassUserNames": []
      }
    },
    // Which Entra JWT callers may use /beacon/mcp (needs bearer JWT on, i.e. Oidc.McpJwksEndpoint above).
    // Off by default: unknown JWT callers get 403. See docs: features/mcp-entra-callers.
    // Once any caller is active, AllowedTenants is required and bearer validation must check issuer + audience.
    "Mcp": {
      "Callers": {
        "AllowedTenants": [],
        "Users": {
          "Enabled": false,
          "RequiredRoles": [],
          "RequiredGroups": [],
          "AllowAnyTenantUser": false,
          "ProjectIds": [],
          "GroupProjects": {},
          "Scope": "Execute",
          "AutoProvision": true,
          "DefaultRoleName": "Viewer"
        },
        // Exactly one of ClientId (app-only token azp/appid) or ObjectId (service user oid) per entry, e.g.
        // { "Name": "aiproxy", "ClientId": "{AIPROXY_CLIENT_ID}", "ProjectIds": [1], "Scope": "Execute",
        //   "HostClaims": [ { "Type": "permission", "Value": "ViewReports" } ] }
        "Systems": []
      }
    }
    // Uncomment and configure LLM settings to enable AI features
    // "LLM": {
    //   "Provider": "Claude",  // Options: "OpenAI", "Claude", "AzureOpenAI"
    //   "ApiKey": "your-api-key-here",
    //   "Model": "claude-sonnet-4-20250514",  // or "gpt-4o", "gpt-4o-mini"
    //   "FastModel": "gpt-4o-mini",  // Optional: for simple operations
    //   "Endpoint": null,  // Required only for AzureOpenAI
    //   "Limits": {
    //     "MaxConcurrentRequests": 50,
    //     "TokensPerMinute": 80000,
    //     "RequestsPerMinute": 1000,
    //     "MonthlyBudget": 100.00
    //   }
    // },
//      "LLM": {
//        "Provider": "Bedrock",
//        "ApiKey": "",
//        "Region": "eu-west-1",
//        "SessionToken": "",
//        "Model": "eu.anthropic.claude-sonnet-4-5-20250929-v1:0"
//      }
  },
  "ConnectionStrings": {
    // Supply the connection string via user-secrets or environment variables — never commit credentials:
    //   dotnet user-secrets --project Beacon.SampleProject set "ConnectionStrings:BeaconContext" \
    //     "Host=localhost;Database=beacon;Username=postgres;Password=...;Maximum Pool Size=100"
    // Maximum Pool Size bounds Npgsql connections so background workers + request handlers
    // cannot exhaust the server's connection limit at scale.
    "BeaconContext": ""
  }
}

