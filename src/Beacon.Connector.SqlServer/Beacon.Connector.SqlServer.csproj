<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>SQL Server connector for Beacon</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Beacon.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Beacon.Core\Beacon.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Dapper" />
    <!-- Lifts Microsoft.Data.SqlClient's transitive 9.0.x past GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\SqlClient\SqlClientConnectionStringReader.cs" Link="Shared\SqlClientConnectionStringReader.cs" />
    <Compile Include="..\Shared\SqlClient\SqlClientConnectionOptionReader.cs" Link="Shared\SqlClientConnectionOptionReader.cs" />
  </ItemGroup>
</Project>
