<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- A dotnet tool: dotnet tool install -g Moberg.Beacon.Doctor, then beacon-doctor mcp <url>. -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>beacon-doctor</ToolCommandName>

        <!-- Package Information -->
        <Authors>Moberg</Authors>
        <Description>Checks a deployed Beacon MCP endpoint the way an MCP client (Claude's connector) sees it: the 401 challenge, the RFC 9728 protected-resource metadata, the authorization server's metadata and signing keys, PKCE, offline_access, and — with a token — initialize and tools/list. Pass/warn/fail lines, a non-zero exit code on failure.</Description>
        <PackageProjectUrl>https://github.com/moberghr/beacon</PackageProjectUrl>
        <RepositoryUrl>https://github.com/moberghr/beacon</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
        <PackageTags>beacon;mcp;model-context-protocol;diagnostics;entra</PackageTags>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Beacon.Tests" />
    </ItemGroup>

</Project>
