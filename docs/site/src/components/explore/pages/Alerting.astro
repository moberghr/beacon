						<line class="meanLine" x1={CH.padL} x2={CH.w - CH.padR} y1={yAt(MEAN)} y2={yAt(MEAN)} />
						<text class="meanLabel" x={CH.w - CH.padR - 4} y={yAt(MEAN) - 6} text-anchor="end">mean {MEAN.toFixed(1)}</text>
