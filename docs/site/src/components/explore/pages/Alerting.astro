---
import { Code } from '@astrojs/starlight/components';
import ExploreLayout from '../ExploreLayout.astro';
import Section from '../Section.astro';

// ── Section 01: the trigger simulator ───────────────────────────────────────
// Seven hourly runs of one subscription. Each status follows "Which runs notify" in
// features/subscriptions.md: 0 rows is No results whatever the trigger, then the
// minimum row count, then the trigger against the previous run's count.
const SIM_ROWS = [0, 3, 3, 5, 2, 2, 0];
const SIM_TIMES = ['09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00'];
const TRIGGERS = [
	{ id: 'every', label: 'Every execution' },
	{ id: 'changes', label: 'When result count changes' },
	{ id: 'increases', label: 'When result count increases' },
];
const MIN_ROWS = 3;

type Outcome = { status: string; tone: string; reason: string };
function evaluate(trigger: string, minOn: boolean): Outcome[] {
	return SIM_ROWS.map((rows, i) => {
		const prev = i > 0 ? SIM_ROWS[i - 1] : null;
		if (rows === 0) {
			return { status: 'No results', tone: 'none', reason: 'zero rows never notify' };
		}
		if (minOn && rows < MIN_ROWS) {
			return { status: 'Below threshold', tone: 'below', reason: `fewer than ${MIN_ROWS} rows` };
		}
		if (prev === null) {
			return { status: 'Sent', tone: 'sent', reason: 'no earlier run to compare' };
		}
		if (trigger === 'every') {
			return { status: 'Sent', tone: 'sent', reason: 'every run with rows' };
		}
		if (trigger === 'changes') {
			return rows !== prev
				? { status: 'Sent', tone: 'sent', reason: `${prev} → ${rows}, changed` }
				: { status: 'Silenced', tone: 'silent', reason: `${prev} → ${rows}, unchanged` };
		}
		return rows > prev
			? { status: 'Sent', tone: 'sent', reason: `${prev} → ${rows}, higher` }
			: { status: 'Silenced', tone: 'silent', reason: `${prev} → ${rows}, not higher` };
	});
}
const SIM_ALL: Record<string, Outcome[]> = {};
for (const t of TRIGGERS) {
	SIM_ALL[`${t.id}-0`] = evaluate(t.id, false);
	SIM_ALL[`${t.id}-1`] = evaluate(t.id, true);
}
const SIM_DEFAULT = SIM_ALL['changes-0'];
const SIM_MAX = Math.max(...SIM_ROWS);
const sentCount = (o: Outcome[]) => o.filter((x) => x.tone === 'sent').length;

// ── Section 02 and the worked example: one run of "Failed card payments" ────
const DS = 'Payments DB';
const QUERY = 'Failed card payments';
const COLUMNS = ['payment_id', 'merchant', 'amount', 'currency', 'decline_code', 'created_at'];
const ROWS: string[][] = [
	['pay_7Q2K81', 'Northwind Outfitters Ltd', '129.00', 'EUR', 'insufficient_funds', '2026-10-15 09:14'],
	['pay_7Q2K64', 'Blue Fern Cafe', '8.40', 'EUR', 'do_not_honor', '2026-10-15 09:13'],
	['pay_7Q2K50', 'Contoso Travel', '412.75', 'EUR', 'card_velocity_exceeded', '2026-10-15 09:11'],
	['pay_7Q2K47', 'Acme Hardware', '56.10', 'EUR', 'expired_card', '2026-10-15 09:10'],
	['pay_7Q2K33', 'Tailspin Toys', '34.99', 'EUR', 'insufficient_funds', '2026-10-15 09:08'],
	['pay_7Q2K29', 'Fabrikam Home and Garden', '218.00', 'EUR', 'do_not_honor', '2026-10-15 09:06'],
	['pay_7Q2K18', 'Litware Books', '22.50', 'EUR', 'incorrect_cvc', '2026-10-15 09:05'],
	['pay_7Q2K12', 'Adatum Pharmacy', '17.80', 'EUR', 'insufficient_funds', '2026-10-15 09:03'],
	['pay_7Q2K09', 'Proseware Fitness', '49.00', 'EUR', 'expired_card', '2026-10-15 09:02'],
	['pay_7Q2K05', 'Wingtip Florist', '64.30', 'EUR', 'do_not_honor', '2026-10-15 09:01'],
	['pay_7Q2J98', 'Coho Winery', '140.00', 'EUR', 'insufficient_funds', '2026-10-15 09:00'],
	['pay_7Q2J91', 'Lucerne Publishing', '12.00', 'EUR', 'incorrect_cvc', '2026-10-15 08:59'],
];
const TOTAL = ROWS.length;

// Slack: first 25 rows and 5 columns as fixed-width text, built the way SlackTableFormatter
// builds it: each column 3 to 20 characters wide, a centred header, a "-+-" separator row,
// " | " between columns, and a longer cell cut to 17 characters plus "...".
const slackCols = COLUMNS.slice(0, 5);
const slackRows = ROWS.slice(0, 25).map((r) => r.slice(0, 5));
const slackWidths = slackCols.map((h, c) => Math.max(3, Math.min(20, Math.max(h.length, ...slackRows.map((r) => r[c].length)))));
const padCenter = (t: string, w: number) => {
	if (t.length >= w) return t.slice(0, w);
	const left = Math.floor((w - t.length) / 2);
	return ' '.repeat(left) + t + ' '.repeat(w - t.length - left);
};
const padOrTruncate = (t: string, w: number) => (t.length > w ? t.slice(0, w - 3) + '...' : t.padEnd(w));
const SLACK_TABLE = [
	slackCols.map((h, c) => padCenter(h, slackWidths[c])).join(' | '),
	slackWidths.map((w) => '-'.repeat(w)).join('-+-'),
	...slackRows.map((r) => r.map((v, c) => padOrTruncate(v, slackWidths[c])).join(' | ')),
].join('\n').trimEnd();

const WEBHOOK = `{
  "timestamp": "2026-10-15T09:15:03.218Z",
  "source": "Beacon",
  "subscriptionName": "${QUERY}",
  "subscriptionId": 42,
  "dataSourceName": "${DS}",
  "totalRecords": ${TOTAL},
  "executionTimeMs": 212.6,
  "previousResultCount": 0,
  "timedOut": false,
  "records": [
    { "payment_id": "${ROWS[0][0]}", "merchant": "${ROWS[0][1]}", "amount": ${ROWS[0][2]}, "currency": "EUR", "decline_code": "${ROWS[0][4]}", "created_at": "2026-10-15T09:14:08Z" },
    { "payment_id": "${ROWS[1][0]}", "merchant": "${ROWS[1][1]}", "amount": ${ROWS[1][2]}, "currency": "EUR", "decline_code": "${ROWS[1][4]}", "created_at": "2026-10-15T09:13:41Z" }
  ],
  "notificationUrl": "https://beacon.acme.example/beacon/notifications/981"
}`;

const SQL = `SELECT payment_id, merchant, amount, currency, decline_code, created_at
FROM payments.card_payments
WHERE status = 'failed'
  AND created_at > now() - interval '1 hour'
ORDER BY created_at DESC;`;

const CHANNELS = [
	{ id: 'teams', label: 'Teams', color: '#5b5fc7' },
	{ id: 'slack', label: 'Slack', color: '#611f69' },
	{ id: 'email', label: 'Email', color: '#0f766e' },
	{ id: 'jira', label: 'Jira', color: '#0c66e4' },
	{ id: 'webhook', label: 'Webhook', color: '#430cda' },
];

// ── Section 04: anomaly chart (standard deviation method) ───────────────────
// Twenty daily baseline runs, then the run being evaluated. Mean and population
// standard deviation are computed from the baseline only, as the docs describe.
const BASE = [11, 9, 12, 10, 13, 11, 10, 12, 11, 9, 12, 10, 11, 12, 10, 11, 13, 12, 10, 11];
const CURRENT = 14;
const MEAN = BASE.reduce((a, x) => a + x, 0) / BASE.length;
const SD = Math.sqrt(BASE.reduce((a, x) => a + (x - MEAN) ** 2, 0) / BASE.length);
const Z = (CURRENT - MEAN) / SD;
const SENS = [
	{ id: 'low', label: 'Low', k: 3, pct: '40%' },
	{ id: 'medium', label: 'Medium', k: 2, pct: '25%' },
	{ id: 'high', label: 'High', k: 1.5, pct: '15%' },
];
const severityOf = (z: number) => (z >= 4 ? 'Critical' : z >= 3 ? 'High' : z >= 2 ? 'Medium' : 'Low');
const CH = { w: 640, h: 260, padL: 36, padR: 16, padT: 16, padB: 30, min: 4, max: 18 };
const allPts = [...BASE, CURRENT];
const xAt = (i: number) => CH.padL + (i * (CH.w - CH.padL - CH.padR)) / (allPts.length - 1);
const yAt = (v: number) => CH.padT + ((CH.max - v) * (CH.h - CH.padT - CH.padB)) / (CH.max - CH.min);
const linePath = BASE.map((v, i) => `${i === 0 ? 'M' : 'L'}${xAt(i).toFixed(1)},${yAt(v).toFixed(1)}`).join(' ');
const yTicks = [6, 10, 14, 18];
---

<ExploreLayout
	area="alerting"
	eyebrow="Explore · Alerting & tasks"
	title="The right message, to the right <em>channel</em>, only when it matters."
	lede="A subscription decides which runs notify anyone, then delivers the result to vetted recipients on five channels. Runs with rows can open a task that stays open until the data is clean, and anomaly detection can replace fixed triggers with a statistical baseline."
	facts={[
		{ value: '5', label: 'delivery channels' },
		{ value: '3', label: 'notification triggers' },
		{ value: '3', label: 'anomaly methods' },
	]}
	deeper={[
		{ title: 'Notifications', href: '/features/notifications/', desc: 'Channels, recipients, destination policy and delivery history.' },
		{ title: 'Tasks', href: '/features/tasks/', desc: 'Lifecycle, automatic resolution, SLA, assignment and the REST API.' },
		{ title: 'Anomaly detection', href: '/features/anomaly-detection/', desc: 'Methods, sensitivity thresholds, severity and tuning.' },
	]}
>
	<div slot="hero" class="fan" aria-label="One run of the Failed card payments subscription, as delivered to Teams, Slack, email, Jira and a webhook">
		<div class="fanCard teams" style="--i:0">
			<div class="fanHead"><span class="fanDot"></span><b>Teams</b><span>Adaptive Card</span></div>
			<div class="fanTitle">Beacon</div>
			<div class="fanLine">{DS}: {QUERY}</div>
			<div class="fanLine dim">First 10 records · 3 columns</div>
		</div>
		<div class="fanCard slack" style="--i:1">
			<div class="fanHead"><span class="fanDot"></span><b>Slack</b><span>#payments-ops</span></div>
			<div class="fanTitle">[Beacon] {DS} - {QUERY}</div>
			<div class="fanLine">Results: Showing {TOTAL} of {TOTAL} total records</div>
		</div>
		<div class="fanCard email" style="--i:2">
			<div class="fanHead"><span class="fanDot"></span><b>Email</b><span>ops@acme.example</span></div>
			<div class="fanTitle">[Beacon] {DS} - {QUERY}</div>
			<div class="fanLine"><span class="attach">CSV</span> {TOTAL} rows attached</div>
		</div>
		<div class="fanCard jira" style="--i:3">
			<div class="fanHead"><span class="fanDot"></span><b>Jira</b><span>PAY-214</span></div>
			<div class="fanTitle">BEACON: {QUERY}</div>
			<div class="fanLine"><span class="tag">Task</span><span class="tag">Medium</span><span class="tag">Beacon</span></div>
		</div>
		<div class="fanCard webhook" style="--i:4">
			<div class="fanHead"><span class="fanDot"></span><b>Webhook</b><span>POST · application/json</span></div>
			<div class="fanCode mono">{`{ "source": "Beacon", "totalRecords": ${TOTAL}, "previousResultCount": 0, … }`}</div>
		</div>
	</div>

	<Section num="01" label="Triggers" title="When does a run notify?" lede="Every run is recorded with a status, and recipients are notified only when it is Sent. A run with no rows ends as No results, whatever the trigger. Pick a trigger to see how the same seven runs play out.">
		<div class="sim" data-sim data-json={JSON.stringify(SIM_ALL)}>
			<div class="simControls">
				<div class="seg" role="group" aria-label="Send notification">
					{
						TRIGGERS.map((t) => (
							<button type="button" class="segBtn" data-trigger={t.id} aria-pressed={t.id === 'changes' ? 'true' : 'false'}>
								{t.label}
							</button>
						))
					}
				</div>
				<label class="minToggle"><input type="checkbox" data-min /> Minimum row count: <span class="mono">{MIN_ROWS}</span></label>
			</div>
			<ol class="simRuns">
				{
					SIM_ROWS.map((rows, i) => (
						<li class={`simRun ${SIM_DEFAULT[i].tone}`} data-run={i}>
							<span class="simTime mono">{SIM_TIMES[i]}</span>
							<span class="simBarBox">
								<span class="simBar" style={`height:${Math.max(4, (rows / SIM_MAX) * 100)}%`} />
							</span>
							<span class="simRows"><b>{rows}</b> rows</span>
							<span class="simStatus" data-status>{SIM_DEFAULT[i].status}</span>
							<span class="simReason" data-reason>{SIM_DEFAULT[i].reason}</span>
						</li>
					))
				}
			</ol>
			<p class="simSummary" aria-live="polite"><b data-count>{sentCount(SIM_DEFAULT)}</b> of {SIM_ROWS.length} runs notify the recipients.</p>
			<div class="simLegend">
				<span><i class="sent"></i>Sent: recipients notified</span>
				<span><i class="silent"></i>Silenced: the trigger did not fire</span>
				<span><i class="below"></i>Below threshold: fewer rows than the minimum</span>
				<span><i class="none"></i>No results: the query returned no rows</span>
			</div>
			<p class="note">A run is compared with the last run that was not skipped. With anomaly detection on, the trigger is not used: after the same checks, a run is Sent only when its row count is unusual (section 04).</p>
		</div>
	</Section>

	<Section num="02" label="Channels" title="One run, five formats." alt lede="Each channel receives the same run in its own format: a title, the preview rows (at most 20, cut further by the subscription's Max rows and the channel's own limits), and the total row count. Rows are PII-masked before any channel sees them.">
		<div class="tabs" data-tabs>
			<div class="tabList" role="tablist" aria-label="Notification channels">
				{
					CHANNELS.map((c, i) => (
						<button type="button" role="tab" id={`ch-tab-${c.id}`} aria-controls={`ch-panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} style={`--brand:${c.color}`}>
							<span class="tabDot" />
							{c.label}
						</button>
					))
				}
			</div>

			<div class="chGrid">
				<div class="chPanels">
					<div role="tabpanel" id="ch-panel-teams" aria-labelledby="ch-tab-teams" class="chPanel">
						<div class="mock teamsCard">
							<div class="mockBar"><span>TEAMS · ADAPTIVE CARD 1.5</span><span>via Workflows webhook</span></div>
							<div class="mockBody">
								<div class="tcTitle">Beacon</div>
								<div class="tcSub">{DS}: {QUERY}</div>
								<div class="tcHead">First 10 records</div>
								<div class="scrollX">
									<table class="mockTable compact">
										<thead><tr>{COLUMNS.slice(0, 3).map((c) => <th>{c}</th>)}</tr></thead>
										<tbody>{ROWS.slice(0, 10).map((r) => <tr>{r.slice(0, 3).map((v) => <td class="mono">{v}</td>)}</tr>)}</tbody>
									</table>
								</div>
								<span class="tcBtn">View Query Results</span>
							</div>
						</div>
					</div>

					<div role="tabpanel" id="ch-panel-slack" aria-labelledby="ch-tab-slack" class="chPanel" hidden>
						<div class="mock slackMsg">
							<div class="mockBar"><span>SLACK · BLOCK KIT</span><span>incoming webhook</span></div>
							<div class="mockBody">
								<div class="slFrom"><span class="slAvatar">B</span><b>Beacon</b><span class="dimTxt">09:15</span></div>
								<div class="slHeader">[Beacon] {DS} - {QUERY}</div>
								<div class="slText">Results: Showing {TOTAL} of {TOTAL} total records</div>
								<pre class="slCode">{SLACK_TABLE}</pre>
								<span class="slBtn">View Full Results</span>
							</div>
						</div>
					</div>

					<div role="tabpanel" id="ch-panel-email" aria-labelledby="ch-tab-email" class="chPanel" hidden>
						<div class="mock emailMsg">
							<div class="mockBar"><span>EMAIL · HTML</span><span>through the host's IEmailAdapter</span></div>
							<div class="mockBody">
								<dl class="emHead">
									<dt>To</dt><dd class="mono">ops@acme.example</dd>
									<dt>Subject</dt><dd><b>[Beacon] {DS} - {QUERY}</b></dd>
								</dl>
								<p class="emLine">Total records: <b>{TOTAL}</b></p>
								<div class="scrollX emTable">
									<table class="mockTable compact">
										<thead><tr>{COLUMNS.map((c) => <th>{c}</th>)}</tr></thead>
										<tbody>{ROWS.map((r) => <tr>{r.map((v) => <td class="mono">{v}</td>)}</tr>)}</tbody>
									</table>
								</div>
								<div class="emAttach"><span class="attach">CSV</span><span><b>Attachment</b> · {TOTAL} rows, PII-masked · CSV or XLSX, as the subscription sets</span></div>
							</div>
						</div>
					</div>

					<div role="tabpanel" id="ch-panel-jira" aria-labelledby="ch-tab-jira" class="chPanel" hidden>
						<div class="mock jiraIssue">
							<div class="mockBar"><span>JIRA CLOUD · PAY-214</span><span>REST API</span></div>
							<div class="mockBody">
								<div class="jiTitle">BEACON: {QUERY}</div>
								<dl class="jiFields">
									<dt>Type</dt><dd><span class="tag">Task</span></dd>
									<dt>Priority</dt><dd><span class="tag">Medium</span></dd>
									<dt>Labels</dt><dd><span class="tag">Beacon</span></dd>
								</dl>
								<div class="jiDesc">
									<div class="jiLabel">Description</div>
									<p>Total records: <b>{TOTAL}</b></p>
									<div class="jiSub">First {TOTAL} records:</div>
									<div class="scrollX">
										<table class="mockTable compact">
											<thead><tr>{COLUMNS.map((c) => <th>{c}</th>)}</tr></thead>
											<tbody>{ROWS.map((r) => <tr>{r.map((v) => <td class="mono">{v}</td>)}</tr>)}</tbody>
										</table>
									</div>
								</div>
								<div class="jiLabel">Activity</div>
								<ol class="jiComments">
									<li><b>09:15</b> Beacon added the same content as a comment (12 rows).</li>
									<li><b>09:45</b> Beacon commented: a later delivery, 15 rows.</li>
									<li><b>10:00</b> Beacon commented: a later delivery, 18 rows.</li>
								</ol>
							</div>
						</div>
					</div>

					<div role="tabpanel" id="ch-panel-webhook" aria-labelledby="ch-tab-webhook" class="chPanel" hidden>
						<Code code={WEBHOOK} lang="json" title="POST https://hooks.acme.example/beacon (records shortened)" />
					</div>
				</div>

				<div class="chFacts">
					<table class="mockTable chTable">
						<thead><tr><th>Channel</th><th>Inline rows</th><th>Attachment</th></tr></thead>
						<tbody>
							<tr><td><b>Teams</b></td><td>First 10 rows, first 3 columns</td><td class="dimTxt">None</td></tr>
							<tr><td><b>Slack</b></td><td>First 25 rows, first 5 columns, each column cut to 20 characters</td><td class="dimTxt">None</td></tr>
							<tr><td><b>Email</b></td><td>The preview rows, as an HTML table</td><td>CSV or XLSX</td></tr>
							<tr><td><b>Jira</b></td><td>The preview rows, as a table</td><td class="dimTxt">None</td></tr>
							<tr><td><b>Webhook</b></td><td>The preview rows, as JSON</td><td class="dimTxt">None</td></tr>
						</tbody>
					</table>
					<p class="note">Teams, Slack and the webhook link back to the run's notification page when a base URL is set. The SQL is included only with <b>Show query text in notification</b> on. Slack and the webhook also carry anomaly details when detection flagged the run. A webhook recipient can replace the body with its own template.</p>
				</div>
			</div>
		</div>
	</Section>

	<Section num="03" label="Tasks" title="A task stays open while the problem does." lede="With Create a task on, the first run with rows opens a task. Later runs update it, and a run with no rows resolves it. Notifications say that something happened; tasks track whether someone dealt with it.">
		<div class="taskGrid">
			<div class="states" role="img" aria-label="Task lifecycle: no task, then open when a run returns rows, then resolved by a run with no rows or by its assignee. A later run with rows opens a new task.">
				<div class="stateRow">
					<div class="state idle">
						<b>No open task</b>
						<span>Runs with 0 rows change nothing.</span>
					</div>
					<div class="edge"><span>Run returns rows</span></div>
					<div class="state open">
						<b>Open</b>
						<span>One per subscription. Priority, assignee, watchers, snooze, comments.</span>
						<span class="loop">↻ Run with rows: latest count, executions and unique counts update</span>
					</div>
					<div class="edge"><span>Run returns 0 rows, or the assignee resolves it</span></div>
					<div class="state done">
						<b>Resolved</b>
						<span>Never reopened. Keeps its history and investigation log.</span>
					</div>
				</div>
				<div class="returnEdge"><span>Rows come back on a later run: a <b>new</b> task opens, and the old one appears under <b>Related</b>.</span></div>
				<div class="resolveNotes">
					<div><span class="badge ok">Automatic</span> <span class="mono">Auto-resolved: Query returned 0 results</span>, no resolver recorded.</div>
					<div><span class="badge">Manual</span> The assignee clicks <b>Resolve</b> (or presses <kbd>R</kbd>), with optional notes up to 2,000 characters.</div>
				</div>
			</div>

			<div class="mock taskMock">
				<div class="mockBar"><span>TASK #57</span><span class="badge warn">Unresolved</span></div>
				<div class="mockBody">
					<div class="tkTitle">{QUERY}</div>
					<div class="tkMeta"><span class="prio">P2 · High</span><span>Assignee: <b>Ana Horvat</b></span><span>2 watchers</span></div>
					<div class="sla">
						<div class="slaHead"><span>SLA · 4 hours</span><span class="mono">3h 15m left</span></div>
						<div class="slaBar" aria-hidden="true"><span style="width:81%"></span></div>
					</div>
					<div class="tkKpis">
						<div><b>18</b><span>latest rows</span></div>
						<div><b>4</b><span>executions</span></div>
						<div><b>3</b><span>notifications</span></div>
						<div><b>45m</b><span>age</span></div>
					</div>
					<div class="keys"><kbd>R</kbd> resolve <kbd>A</kbd> assign to me <kbd>S</kbd> snooze 1 hour <kbd>C</kbd> comment</div>
				</div>
			</div>
		</div>
		<p class="note">The SLA counts down against the subscription's SLA hours, or 24 hours when none is set; an Admin sets 1 to 720 hours from the task page. Every run that executes the query updates the task, whatever its notification status.</p>
	</Section>

	<Section num="04" label="Anomaly detection" title="Notify on the unusual, not on every change." alt lede="With anomaly detection on, a subscription compares each run's row count with the runs of its lookback window and notifies only when the run is unusual. It is statistical and needs no LLM. Switch the sensitivity to move the threshold.">
		<div class="anomaly" data-anomaly data-sens="medium">
			<div class="mock">
				<div class="mockBar">
					<span>CHARGEBACKS OPENED TODAY · STANDARD DEVIATION</span>
					<div class="seg small" role="group" aria-label="Sensitivity">
