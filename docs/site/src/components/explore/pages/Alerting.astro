					<svg class="chart" viewBox={`0 0 ${CH.w} ${CH.h}`} role="img" aria-label={`Twenty baseline runs around a mean of ${MEAN.toFixed(1)} rows, and a run of ${CURRENT} rows at z = ${Z.toFixed(2)}`}>
						{yTicks.map((t) => (
							<g>
								<line class="grid" x1={CH.padL} x2={CH.w - CH.padR} y1={yAt(t)} y2={yAt(t)} />
