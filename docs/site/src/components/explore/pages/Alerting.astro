						{BASE.map((v, i) => <circle class="pt" cx={xAt(i)} cy={yAt(v)} r="3.5" />)}
						<line class="toCurrent" x1={xAt(BASE.length - 1)} y1={yAt(BASE[BASE.length - 1])} x2={xAt(BASE.length)} y2={yAt(CURRENT)} />
						<circle class="current" cx={xAt(BASE.length)} cy={yAt(CURRENT)} r="6.5" />
						<text class="axis" x={CH.padL} y={CH.h - 8}>20 baseline runs (lookback 30 days)</text>
						<text class="axis" x={CH.w - CH.padR} y={CH.h - 8} text-anchor="end">this run</text>
