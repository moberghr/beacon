<script>
	// Trigger simulator: swap the precomputed outcomes for the chosen trigger and minimum.
	document.querySelectorAll<HTMLElement>('[data-sim]').forEach((root) => {
		const all = JSON.parse(root.dataset.json ?? '{}') as Record<string, { status: string; tone: string; reason: string }[]>;
		const buttons = root.querySelectorAll<HTMLButtonElement>('[data-trigger]');
		const min = root.querySelector<HTMLInputElement>('[data-min]');
		const runs = root.querySelectorAll<HTMLElement>('[data-run]');
		const count = root.querySelector<HTMLElement>('[data-count]');
		let trigger = 'changes';
		const render = () => {
			const outcomes = all[`${trigger}-${min?.checked ? 1 : 0}`] ?? [];
			runs.forEach((run, i) => {
				const o = outcomes[i];
				if (!o) {
					return;
				}
				run.classList.remove('sent', 'silent', 'below', 'none');
				run.classList.add(o.tone);
				run.querySelector('[data-status]')!.textContent = o.status;
				run.querySelector('[data-reason]')!.textContent = o.reason;
			});
			if (count) {
				count.textContent = String(outcomes.filter((o) => o.tone === 'sent').length);
			}
		};
		buttons.forEach((b) =>
			b.addEventListener('click', () => {
				trigger = b.dataset.trigger ?? 'changes';
				buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				render();
			})
		);
		min?.addEventListener('change', render);
	});

	// Channel tabs: WAI-ARIA tabs with arrow-key navigation.
	document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
		const select = (tab: HTMLButtonElement, focus: boolean) => {
			tabs.forEach((t) => {
				const on = t === tab;
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
				if (panel) {
					panel.hidden = !on;
				}
			});
			if (focus) {
				tab.focus();
			}
		};
		tabs.forEach((t, i) => {
			t.addEventListener('click', () => select(t, false));
			t.addEventListener('keydown', (e) => {
				const next = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
				if (next !== 0) {
					e.preventDefault();
					select(tabs[(i + next + tabs.length) % tabs.length], true);
				}
			});
		});
	});

	// Anomaly sensitivity switch: the band, verdict and table row follow data-sens.
	document.querySelectorAll<HTMLElement>('[data-anomaly]').forEach((root) => {
		const buttons = root.querySelectorAll<HTMLButtonElement>('[data-sens-btn]');
		buttons.forEach((b) =>
			b.addEventListener('click', () => {
				root.dataset.sens = b.dataset.sensBtn ?? 'medium';
				buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
			})
		);
	});
</script>

