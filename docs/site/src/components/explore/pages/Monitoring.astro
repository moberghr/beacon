---
import { Code } from '@astrojs/starlight/components';
import ExploreLayout from '../ExploreLayout.astro';
import Section from '../Section.astro';
import Flow from '../Flow.astro';
import Shot from '../Shot.astro';

// Last 14 scheduled runs of the example subscription, oldest first.
const RUNS = ['ok', 'ok', 'ok', 'silent', 'ok', 'ok', 'warn', 'ok', 'silent', 'ok', 'ok', 'ok', 'ok', 'sent'];

const STEP1 = `-- Paid orders older than a day
SELECT order_id, customer_id, total, paid_at
FROM shop.orders
WHERE status = 'paid'
  AND paid_at < now() - interval '24 hours';`;

const STEP2 = `-- Shipments created in the last two weeks
SELECT order_id, carrier, created_at
FROM dbo.Shipments
WHERE created_at > DATEADD(day, -14, SYSUTCDATETIME());`;

const FINAL = `-- Runs in Beacon's in-memory SQLite store
SELECT a.order_id, a.customer_id, a.total
FROM @result1 a
LEFT JOIN @result2 b ON b.order_id = a.order_id
WHERE b.order_id IS NULL
ORDER BY a.paid_at;`;

const HEALTH = [
	{ name: 'Paid orders without shipment', rate: 95.5, runs: 22, tasks: 1, state: 'Green' },
	{ name: 'Duplicate invoice numbers', rate: 88.0, runs: 50, tasks: 0, state: 'Amber' },
	{ name: 'Nightly ledger balance', rate: 62.5, runs: 24, tasks: 2, state: 'Red' },
	{ name: 'Stale exchange rates', rate: null, runs: 0, tasks: 0, state: 'Stalled' },
];
// Worst first, as the Control Tower sorts by default: most open tasks, then lowest success rate (no runs counts as 100%).
const WORST_FIRST = HEALTH.slice().sort((a, b) => b.tasks - a.tasks || (a.rate ?? 100) - (b.rate ?? 100));
const toneOf = (state: string) => ({ Green: 'ok', Amber: 'warn', Red: 'crit' } as Record<string, string>)[state] ?? 'neutral';
---

<ExploreLayout
	area="monitoring"
	eyebrow="Explore · Monitoring"
	title="Know about data problems <em>before</em> your users do."
	lede="Beacon runs saved SQL checks on a schedule, across every engine you connect, and records every run. Each check runs as the person who owns it, through the same read-only gate as everything else, and reports its health in the Control Tower."
	facts={[
		{ value: '9', label: 'connectors' },
		{ value: '5-field', label: 'cron schedules' },
		{ value: 'n steps', label: 'joined in memory' },
	]}
	deeper={[
		{ title: 'Queries', href: '/features/queries/', desc: 'Steps, parameters, final queries, versions and folders.' },
		{ title: 'Subscriptions', href: '/features/subscriptions/', desc: 'Schedules, triggers, owners, SLA hours and run statuses.' },
		{ title: 'Control Tower', href: '/features/control-tower/', desc: 'Health buckets, KPIs and the health API.' },
	]}
>
	<div slot="hero" class="subCard mock">
		<div class="mockBar"><span>SUBSCRIPTION</span><span class="badge ok">Active</span></div>
		<div class="mockBody">
			<div class="subName">Paid orders without shipment</div>
			<div class="subMeta"><span class="mono">0 7 * * 1-5</span><span>07:00, Monday to Friday</span></div>
			<div class="runsHead"><span>Last 14 runs</span><span class="legend"><i class="ok"></i>no rows<i class="sent"></i>sent<i class="silent"></i>silenced<i class="warn"></i>timeout</span></div>
			<div class="runs" aria-label="Run history: twelve successful runs, one timeout, one notification sent">
				{RUNS.map((r, i) => <span class={`run ${r}`} style={`--i:${i}`} />)}
			</div>
			<div class="subStats">
				<div><b>95.5%</b><span>success, 30 days</span></div>
				<div><b>3</b><span>rows last run</span></div>
				<div><b>1</b><span>open task</span></div>
			</div>
			<div class="subFoot">
				<span>Owner: <b>Ana Horvat</b></span>
				<span>Recipients: <b>#fulfilment</b>, ops@acme.example</span>
			</div>
		</div>
	</div>

	<Section num="01" label="How a check runs" title="Six steps from a cron tick to a message." lede="A subscription is a schedule attached to a saved query. When the schedule fires, your job runner calls Beacon, and Beacon does the rest.">
		<Flow
			seconds={7}
			steps={[
				{ label: 'Schedule fires', detail: 'Your job runner triggers the subscription from its cron expression.' },
				{ label: 'Run as owner', detail: 'Beacon runs it as its owner and re-checks access to every data source.' },
				{ label: 'Run each step', detail: 'Each step runs on its own data source, through the read-only gate.' },
				{ label: 'Join in memory', detail: 'A final query joins @result1, @result2 in an in-memory SQLite store.' },
				{ label: 'Decide', detail: 'The trigger, minimum row count and anomaly detection decide whether to notify.' },
				{ label: 'Deliver', detail: 'Recipients get the result, a task opens or resolves, the run is recorded.' },
			]}
		/>
	</Section>

	<Section num="02" label="Worked example" title="Paid orders that never shipped." alt lede="The shop database (PostgreSQL) knows which orders are paid; the warehouse database (SQL Server) knows which have shipped. No single database can answer the question, so the query has two steps and a final query that joins them.">
		<div class="exampleGrid">
			<div class="stack">
				<Code code={STEP1} lang="sql" title="Step 1 · Shop (PostgreSQL)" />
				<Code code={STEP2} lang="sql" title="Step 2 · Warehouse (SQL Server)" />
				<Code code={FINAL} lang="sql" title="Final query · @result1 joined with @result2" />
				<p class="note">Both data sources are linked to the same project, so the query can read them together. The final query is SQLite SQL; it is set through the API or by an AI actor, and the editor shows it read-only.</p>
			</div>
			<div class="stack">
				<div class="mock settings">
					<div class="mockBar"><span>NEW SUBSCRIPTION</span><span>Review</span></div>
					<div class="mockBody">
						<dl>
							<dt>Cron expression</dt><dd><span class="mono">0 7 * * 1-5</span></dd>
							<dt>Send notification</dt><dd>When result count changes</dd>
							<dt>Recipients</dt><dd>Teams <span class="mono">#fulfilment</span>, email <span class="mono">ops@acme.example</span></dd>
							<dt>Attachment</dt><dd>CSV, up to the subscription's max rows</dd>
							<dt>Tasks</dt><dd>Keep a task open while the query returns rows</dd>
						</dl>
					</div>
				</div>

				<div class="arrowDown" aria-hidden="true">Monday, 07:00 · 3 rows · count changed from 1</div>

				<div class="teams mock">
					<div class="teamsHead"><span class="teamsApp">Beacon</span><span class="teamsTime">07:00</span></div>
					<div class="mockBody">
						<div class="teamsTitle">Paid orders without shipment</div>
						<div class="teamsSub">Query Results</div>
						<table class="mockTable">
							<thead><tr><th>order_id</th><th>customer_id</th><th>total</th></tr></thead>
							<tbody>
								<tr><td class="mono">104 211</td><td class="mono">58 120</td><td class="mono">129.00</td></tr>
								<tr><td class="mono">104 236</td><td class="mono">11 904</td><td class="mono">48.50</td></tr>
								<tr><td class="mono">104 240</td><td class="mono">73 455</td><td class="mono">312.90</td></tr>
							</tbody>
						</table>
						<span class="teamsBtn">View Query Results</span>
					</div>
				</div>
				<div class="taskChip"><span class="badge warn">Task opened</span> Stays open until a run returns no rows, then resolves itself.</div>
			</div>
		</div>
	</Section>

	<Section num="03" label="Control Tower" title="One page that shows whether your checks are healthy." lede="The Control Tower groups every subscription by its success rate over the selected window. Success means a run that sent, silenced or found nothing; a skipped run counts against it.">
		<div class="tower">
			<div class="buckets">
				<div class="bucket ok"><b>Green</b><span>90% or more of runs succeed</span></div>
				<div class="bucket warn"><b>Amber</b><span>70% to 90%</span></div>
				<div class="bucket crit"><b>Red</b><span>below 70%</span></div>
				<div class="bucket neutral"><b>Stalled</b><span>no runs, created more than a day ago</span></div>
			</div>
			<div class="mock">
				<div class="mockBar"><span>HEALTH · LAST 30 DAYS</span><span>worst first</span></div>
				<div class="mockBody">
					<table class="mockTable">
						<thead><tr><th>State</th><th>Subscription</th><th>Success</th><th>Runs</th><th>Open tasks</th></tr></thead>
						<tbody>
							{
								WORST_FIRST.map((h) => (
									<tr>
										<td><span class={`badge ${toneOf(h.state)}`}>{h.state}</span></td>
										<td>{h.name}</td>
										<td>
											{h.rate === null ? (
												<span class="dim">no runs</span>
											) : (
												<span class="rate">
													<span class="rateBar"><span class={toneOf(h.state)} style={`width:${h.rate}%`} /></span>
													<span class="mono">{h.rate.toFixed(1)}%</span>
												</span>
											)}
										</td>
										<td class="mono">{h.runs}</td>
										<td class="mono">{h.tasks}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<div style="margin-top: 36px">
			<Shot name="control-tower-dark" alt="The Control Tower in the dark theme" caption="The Control Tower: health buckets, KPIs, and badges for runs skipped because an owner lost access or a change is not approved." />
		</div>
	</Section>

	<Section num="04" label="Guarantees" title="What every run can rely on." alt>
		<div class="cols3">
			<div class="card">
				<div class="cardIcon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5" /><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6" /></svg></div>
				<h3>Runs as its owner</h3>
				<p>A scheduled run uses its owner's access, checked again before any SQL runs. If the owner loses access, the run is recorded as skipped and nothing is sent.</p>
			</div>
			<div class="card">
				<div class="cardIcon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4v5c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V7l8-4z" /></svg></div>
				<h3>Read-only, always</h3>
				<p>Every step passes the SQL execution gate in its own dialect. Writes, DDL, other databases and dynamic SQL are rejected before anything reaches the database.</p>
			</div>
			<div class="card">
				<div class="cardIcon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h9" /></svg></div>
				<h3>Bounded results</h3>
				<p>A row cap (100,000 by default) is written into the SQL, and each statement has a timeout (120 seconds by default). A larger result fails the run rather than being cut silently.</p>
			</div>
			<div class="card">
				<div class="cardIcon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10.5" width="16" height="10" rx="2" /><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5" /></svg></div>
				<h3>Masked before delivery</h3>
				<p>Rows that reach recipients and attachments are PII-masked under the strictest settings of the projects that link the data.</p>
			</div>
			<div class="card">
				<div class="cardIcon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l2.5 2.5L16 9" /><circle cx="12" cy="12" r="9" /></svg></div>
				<h3>Reviewed SQL only</h3>
				<p>With the approval workflow on, a scheduled run executes only the query's active version. Anything else is skipped and marked "Not approved". In strict mode the version must also carry an approval for exactly its content.</p>
			</div>
			<div class="card">
				<div class="cardIcon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5M4 19h16M8 15l3-4 3 2 5-6" /></svg></div>
				<h3>Every run recorded</h3>
				<p>Each run keeps its status, row count and timing. The count drives the trigger, the minimum row count, anomaly detection and tasks; the status drives the Control Tower.</p>
			</div>
		</div>
	</Section>
</ExploreLayout>

<style>
	/* Hero subscription card */
	.subCard { max-width: 520px; margin-left: auto; }
	.subName { font-size: 18px; font-weight: 600; margin-bottom: 6px; }
	.subMeta { display: flex; gap: 12px; align-items: baseline; font-size: 13px; color: var(--bx-text-muted); margin-bottom: 18px; }
	.subMeta .mono { color: var(--bx-accent); background: var(--bx-accent-dim); padding: 2px 8px; border-radius: 6px; }
	.runsHead { display: flex; justify-content: space-between; align-items: center; gap: 10px; font-size: 11.5px; color: var(--bx-text-dim); margin-bottom: 8px; flex-wrap: wrap; }
	.legend { display: inline-flex; gap: 6px; align-items: center; }
	.legend i { width: 8px; height: 8px; border-radius: 2px; display: inline-block; margin-left: 6px; }
	.runs { display: grid; grid-template-columns: repeat(14, minmax(0, 1fr)); gap: 5px; height: 44px; align-items: end; }
	.run { border-radius: 4px; height: 100%; opacity: 0; animation: grow .5s ease forwards; animation-delay: calc(var(--i) * 0.07s + 0.2s); transform-origin: bottom; }
	@keyframes grow { from { opacity: 0; transform: scaleY(0.2); } to { opacity: 1; transform: none; } }
	@media (prefers-reduced-motion: reduce) { .run { opacity: 1; } }
	.ok, .legend .ok { background: var(--xp-ok); }
	.sent, .legend .sent { background: var(--bx-accent); }
	.silent, .legend .silent { background: color-mix(in srgb, var(--xp-ok) 45%, transparent); }
	.warn, .legend .warn { background: var(--xp-warn); }
	.subStats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 18px 0 14px; }
	.subStats div { border: 1px solid var(--bx-border); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; }
	.subStats b { font-size: 20px; }
	.subStats span { font-size: 11.5px; color: var(--bx-text-dim); }
	.subFoot { display: flex; flex-direction: column; gap: 3px; font-size: 12.5px; color: var(--bx-text-muted); }

	/* Example */
	.exampleGrid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 28px; align-items: start; }
	.settings dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 9px 16px; margin: 0; font-size: 13.5px; }
	.settings dt { color: var(--bx-text-dim); }
	.settings dd { margin: 0; color: var(--bx-text); }
	.arrowDown { position: relative; text-align: center; font-size: 12px; font-family: var(--sl-font-mono); color: var(--bx-text-dim); padding: 22px 0 10px; }
	.arrowDown::before { content: ''; position: absolute; left: 50%; top: 0; height: 18px; width: 2px; background: var(--bx-accent); opacity: 0.5; }
	.teams { border-left: 4px solid #5b5fc7; }
	.teamsHead { display: flex; justify-content: space-between; padding: 10px 16px 0; font-size: 12px; }
	.teamsApp { font-weight: 600; color: #5b5fc7; }
	.teamsTime { color: var(--bx-text-dim); }
	.teamsTitle { font-size: 16px; font-weight: 700; margin-bottom: 2px; }
	.teamsSub { font-size: 12px; color: var(--bx-text-dim); margin-bottom: 10px; }
	.teamsBtn { display: inline-block; margin-top: 12px; font-size: 13px; font-weight: 600; padding: 6px 16px; border-radius: 6px; border: 1px solid var(--bx-border); color: #5b5fc7; }
	.taskChip { display: flex; gap: 10px; align-items: center; font-size: 13px; color: var(--bx-text-muted); }

	/* Control Tower */
	.tower { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr); gap: 24px; align-items: start; }
	.buckets { display: flex; flex-direction: column; gap: 10px; }
	.bucket { border-radius: 12px; padding: 14px 16px; border: 1px solid var(--bx-border); background: var(--bx-surface); display: flex; flex-direction: column; gap: 2px; border-left-width: 4px; }
	.bucket.ok { border-left-color: var(--xp-ok); }
	.bucket.warn { border-left-color: var(--xp-warn); }
	.bucket.crit { border-left-color: var(--xp-crit); }
	.bucket.neutral { border-left-color: var(--bx-text-dim); }
	.bucket b { font-size: 15px; }
	.bucket span { font-size: 13px; color: var(--bx-text-muted); }
	.rate { display: inline-flex; align-items: center; gap: 8px; }
	.rateBar { width: 80px; height: 6px; border-radius: 3px; background: var(--bx-surface2); overflow: hidden; display: inline-block; }
	.rateBar span { display: block; height: 100%; }
	.rateBar .ok { background: var(--xp-ok); }
	.rateBar .warn { background: var(--xp-warn); }
	.rateBar .crit { background: var(--xp-crit); }
	.dim { color: var(--bx-text-dim); font-size: 12.5px; }

	@media (max-width: 1024px) {
		.subCard { margin: 0; max-width: none; }
		.exampleGrid, .tower { grid-template-columns: minmax(0, 1fr); }
	}
	@media (max-width: 640px) {
		.legend { display: none; }
		.mockTable :global(th:nth-child(4)), .mockTable :global(td:nth-child(4)) { display: none; }
	}
</style>
