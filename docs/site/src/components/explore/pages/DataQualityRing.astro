---
// A score gauge: an SVG ring filled to the score (0 to 100), green at or above the
// threshold (the Data Quality page counts a table as Healthy from 80) and red below it.
interface Props {
	score: number;
	threshold?: number;
	size?: number;
	label?: string;
	delay?: number;
}
const { score, threshold = 80, size = 112, label, delay = 0 } = Astro.props;
const r = 44;
const c = 2 * Math.PI * r;
const offset = c * (1 - Math.max(0, Math.min(100, score)) / 100);
const tone = score >= threshold ? 'ok' : 'crit';
---

<figure class={`ring ${tone}`} style={`--size:${size}px; --c:${c.toFixed(2)}; --delay:${delay}s`}>
	<svg viewBox="0 0 100 100" role="img" aria-label={`${label ? `${label}: ` : ''}score ${score.toFixed(2)}%`}>
		<circle class="track" cx="50" cy="50" r={r} />
		<circle class="arc" cx="50" cy="50" r={r} stroke-dasharray={c.toFixed(2)} stroke-dashoffset={offset.toFixed(2)} />
		<line class="mark" x1="50" y1="2" x2="50" y2="12" transform={`rotate(${(threshold / 100) * 360} 50 50)`} />
	</svg>
	<span class="value"><b>{score.toFixed(score % 1 === 0 ? 0 : 1)}</b><small>%</small></span>
</figure>

<style>
	.ring { position: relative; width: min(var(--size), 100%); aspect-ratio: 1; margin: 0; flex-shrink: 0; }
	svg { width: 100%; height: 100%; transform: rotate(-90deg); display: block; }
	.track { fill: none; stroke: var(--bx-surface2); stroke-width: 8; }
	.arc { fill: none; stroke-width: 8; stroke-linecap: round; animation: ringFill 1.1s cubic-bezier(.2, .7, .3, 1) both; animation-delay: var(--delay); }
	.ok .arc { stroke: var(--xp-ok); }
	.crit .arc { stroke: var(--xp-crit); }
	.mark { stroke: var(--bx-text-dim); stroke-width: 2; }
	@keyframes ringFill { from { stroke-dashoffset: var(--c); } }
	.value { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 1px; color: var(--bx-text); }
	.value b { font-size: calc(var(--size) * 0.24); font-weight: 600; letter-spacing: -0.02em; }
	.value small { font-size: calc(var(--size) * 0.11); color: var(--bx-text-dim); margin-top: calc(var(--size) * 0.06); }
</style>
