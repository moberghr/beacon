</ExploreLayout>

<script>
	type State = 'yes' | 'no' | 'owner';
	const ACTIONS = ['Read', 'Run', 'Query', 'Write', 'Manage', 'ManageMembers', 'Curate'];
	const SETS: Record<string, State[]> = {
		none: ['no', 'no', 'no', 'no', 'no', 'no', 'no'],
		viewer: ['yes', 'yes', 'no', 'no', 'no', 'no', 'no'],
		editorRestricted: ['yes', 'yes', 'yes', 'yes', 'owner', 'no', 'no'],
		editorOpen: ['yes', 'yes', 'yes', 'yes', 'yes', 'no', 'no'],
		all: ['yes', 'yes', 'yes', 'yes', 'yes', 'yes', 'yes'],
	};

	function evaluate(g: string, m: string, p: string): { set: string; role: string; tone: string; note: string } {
		if (g === 'Admin') {
			return { set: 'all', role: 'Admin', tone: '', note: 'An Admin reaches every live project with every action, open or restricted, member or not.' };
		}
		if (p === 'restricted' && m === 'None') {
			return { set: 'none', role: '404', tone: 'crit', note: 'A restricted project, and not a member: the project answers 404. The caller cannot tell it from a project that does not exist.' };
		}
		if (g === 'Viewer') {
			const capped = m === 'Editor' || m === 'ProjectAdmin';
			return {
				set: 'viewer',
				role: 'Viewer',
				tone: '',
				note: capped
					? `A global Viewer is a Viewer in every project, whatever their membership. The ${m} membership does not lift it.`
					: p === 'open' && m === 'None'
						? 'An open project: everyone with a Beacon role uses it at their global role. A Viewer reads and runs saved SQL.'
						: 'A Viewer reads and runs saved SQL, and works with no ad-hoc SQL.',
			};
		}
		if (m === 'ProjectAdmin') {
			return { set: 'all', role: 'ProjectAdmin', tone: '', note: 'A project admin holds every action in the project, including ManageMembers and Curate, which only this membership grants.' };
		}
		if (p === 'open') {
			return { set: 'editorOpen', role: 'Editor', tone: '', note: 'An open project: an Editor acts with the higher of their membership and their global role, and holds Manage. ManageMembers and Curate still need a ProjectAdmin membership.' };
		}
		if (m === 'Viewer') {
			return { set: 'viewer', role: 'Viewer', tone: '', note: 'A restricted project: the member acts with their membership role, here Viewer, even though their global role is Editor.' };
		}
		return { set: 'editorRestricted', role: 'Editor', tone: '', note: 'A restricted project: the Editor member acts with their membership role. Manage applies to what they own (a lock they hold, a subscription or contract they own).' };
	}

	const LABEL: Record<State, string> = { yes: 'granted', no: 'not granted', owner: 'as recorded owner' };

	for (const root of document.querySelectorAll<HTMLElement>('[data-switcher]')) {
		const update = () => {
			const value = (name: string) => root.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? '';
			const result = evaluate(value('g'), value('m'), value('p'));
			const states = SETS[result.set];
			ACTIONS.forEach((name, i) => {
				const item = root.querySelector<HTMLElement>(`[data-action="${name}"]`);
				if (!item) {
					return;
				}
				item.classList.remove('yes', 'no', 'owner');
				item.classList.add(states[i]);
				const label = item.querySelector('.actState');
				if (label) {
					label.textContent = LABEL[states[i]];
				}
			});
			const role = root.querySelector<HTMLElement>('[data-role]');
			if (role) {
				role.textContent = result.role === '404' ? '404 Not Found' : `Acts as ${result.role}`;
				role.className = `badge${result.tone ? ` ${result.tone}` : ''}`;
			}
			const note = root.querySelector('[data-note]');
			if (note) {
				note.textContent = result.note;
			}
		};
		root.addEventListener('change', update);
		update();
	}

	// Gate: highlight the stages a sample passes and the stage that refuses it.
	for (const root of document.querySelectorAll<HTMLElement>('[data-gate]')) {
		const show = (id: string) => {
			let stop = 0;
			for (const panel of root.querySelectorAll<HTMLElement>('[data-panel]')) {
				const active = panel.dataset.panel === id;
				panel.hidden = !active;
				if (active) {
					stop = Number(panel.dataset.stop ?? 0);
				}
			}
			for (const button of root.querySelectorAll<HTMLElement>('[data-sample]')) {
				button.setAttribute('aria-pressed', String(button.dataset.sample === id));
			}
			for (const stage of root.querySelectorAll<HTMLElement>('[data-stage]')) {
				const n = Number(stage.dataset.stage);
				stage.classList.remove('pass', 'stop', 'skip');
				stage.classList.add(stop === 0 || n < stop ? 'pass' : n === stop ? 'stop' : 'skip');
			}
		};
		root.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLElement>('[data-sample]');
			if (button?.dataset.sample) {
				show(button.dataset.sample);
			}
		});
	}

	// Worked example tabs.
	for (const root of document.querySelectorAll<HTMLElement>('[data-scenarios]')) {
		root.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLElement>('[data-scenario]');
			const id = button?.dataset.scenario;
			if (!id) {
				return;
			}
			for (const panel of root.querySelectorAll<HTMLElement>('[data-spanel]')) {
				panel.hidden = panel.dataset.spanel !== id;
			}
			for (const tab of root.querySelectorAll<HTMLElement>('[data-scenario]')) {
				tab.setAttribute('aria-pressed', String(tab.dataset.scenario === id));
			}
		});
	}
</script>

