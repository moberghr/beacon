<script>
	// Statement checker tabs: click or arrow keys switch the visible pane.
	for (const root of document.querySelectorAll<HTMLElement>('[data-checker]')) {
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
		const select = (tab: HTMLButtonElement) => {
			for (const t of tabs) {
				const on = t === tab;
				t.setAttribute('aria-selected', on ? 'true' : 'false');
				t.tabIndex = on ? 0 : -1;
				const pane = root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`);
				if (pane) {
					pane.hidden = !on;
				}
			}
		};
		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => select(tab));
			tab.addEventListener('keydown', (e) => {
				if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') {
					return;
				}
				e.preventDefault();
				const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
				select(next);
				next.focus();
			});
		});
	}
</script>

