---
import { Code } from '@astrojs/starlight/components';
import ExploreLayout from '../ExploreLayout.astro';
import Section from '../Section.astro';
import Flow from '../Flow.astro';
import Terminal from '../Terminal.astro';

const DBCONTEXT = `builder.Services.AddBeaconServices(builder.Configuration, options => { /* … */ })
    .ExposeDbContext<ShopDbContext>(x =>
    {
        x.ProjectName = "Shop";                    // the host project
        x.ReadOnlyConnection("ShopReadOnly")       // ConnectionStrings:ShopReadOnly, a read-only login
            .AllowTables("Orders", "OrderLines", "Customers")
            .AllowEntity<Product>()
            .ExcludeColumns(y => y.Table == "Customers" && y.Name == "Notes")
            .MaskColumns(y => y.Name is "Email" or "Phone");
    })
    .AddSqlServerConnector()
    .UseSqlServer();                               // ends the chain: ExposeDbContext comes first`;

const DOCS = `    .ExposeDocs(x =>
    {
        x.ProjectName = "Shop";
        x.FromDirectory("docs", "**/*.md").Exclude("drafts/**");
        // x.FromEmbeddedResources(typeof(Program).Assembly, "Shop.Docs.");
        // x.MaxDocumentBytes = 512 * 1024;
    })`;

const ENDPOINT = `builder.Services.AddBeaconMcp()
    .AddHostEndpointTools(x =>
    {
        x.ProjectName = "Shop";       // the host project the tools belong to
        // x.AllowWriteTools = true;  // off by default
    });

app.MapGet("/api/orders/{id:int}", (int id, OrderService orders) => orders.Find(id))
    .RequireAuthorization("ViewOrders")
    .WithBeaconTool("order_by_id", "One order by id.", readOnly: true);`;

const CONTROLLER = `[HttpGet("{customerId:int}/orders")]
[Authorize(Policy = "ViewOrders")]
[BeaconTool("customer_orders", Description = "Orders of one customer, newest first.", ReadOnly = true)]
public IActionResult CustomerOrders(int customerId) { /* … */ }`;

const STARTUP = `builder.Services.AddBeaconServices(builder.Configuration, options => { /* … */ })
    .ExposeDbContext<ShopDbContext>(x => { /* allow-list, exclusions, masks */ })
    .ExposeDocs(x => { /* docs folder */ })
    .AddSqlServerConnector()
    .UseSqlServer();                          // ends the chain: host extensions come first

builder.Services.AddBeaconMcp()
    .AddHostEndpointTools(x => x.ProjectName = "Shop");

var app = builder.Build();
Beacon.Core.ServiceConfiguration.UseBeacon(app.Services, createSchema: true);
await app.Services.SyncBeaconHostAsync();     // data sources first, then docs; idempotent; replica-safe lock`;

const SAVED_SQL = `-- Step 1 · ShopDbContext (host data source)
SELECT o.Id, o.Status, o.PlacedAt, o.Total
FROM dbo.Orders o
WHERE o.Status = {status}
  AND o.PlacedAt >= {placed_from}`;

const SEARCH_HTML = `<span class="k-dim">→ search</span> <span class="k-mute">{ "query": "when is an order shipped" }</span>

- **<span class="k-purple">[IMPORTED_DOC]</span>** \`<span class="k-yellow">orders/statuses.md</span>\` (Order statuses) <span class="k-dim">--</span> An order moves to
  Shipped when the carrier confirms the pickup …
- **<span class="k-purple">[IMPORTED_DOC]</span>** \`<span class="k-yellow">support/escalation.md</span>\` (Escalating a delayed order)

<span class="k-dim">→ get_documentation</span> <span class="k-mute">{ "document": "orders/statuses.md" }</span>

<span class="k-green"># Order statuses</span>
Every order is in exactly one status: Placed, Paid, Shipped,
Delivered or Cancelled. An order moves to Shipped when …`;

// The policy checker in section 01: statements an assistant might send, and what the host policy decides.
const CHECKS = [
	{
		id: 'ok',
		label: 'Allowed',
		sql: 'SELECT c.Id, c.Name, c.Email\nFROM dbo.Customers c\nWHERE c.Id = 11904',
		tone: 'ok',
		verdict: 'Runs',
		detail: 'Every table is allow-listed and schema-qualified. Email is a direct projection, so it is returned masked.',
		rows: true,
	},
	{
		id: 'unqualified',
		label: 'Unqualified table',
		sql: 'SELECT Name\nFROM Customers',
		tone: 'crit',
		verdict: 'Rejected',
		detail: 'Qualify the table: dbo.Customers. The connection’s default schema may differ from the model’s, so every table must be schema-qualified.',
	},
	{
		id: 'star',
		label: 'SELECT *',
		sql: 'SELECT *\nFROM dbo.Customers',
		tone: 'crit',
		verdict: 'Rejected',
		detail: 'SELECT * and t.* are rejected with a list of the exposed columns to use instead.',
	},
	{
		id: 'probe',
		label: 'Masked in WHERE',
		sql: "SELECT c.Name\nFROM dbo.Customers c\nWHERE c.Email LIKE '%@acme.example'",
		tone: 'crit',
		verdict: 'Rejected',
		detail: 'A masked column may appear only as a direct projection, in COUNT(col), or in IS NULL / IS NOT NULL, so masked values cannot be probed.',
	},
	{
		id: 'excluded',
		label: 'Excluded column',
		sql: 'SELECT c.Notes\nFROM dbo.Customers c',
		tone: 'crit',
		verdict: 'Rejected',
		detail: 'Excluded columns are invisible in metadata and rejected anywhere in a statement.',
	},
];

const REPLACEABLE = [
	['IBeaconScheduler', 'None (required)', 'Use your job runner.'],
	['IEmailAdapter', 'none', 'Send email (AddEmailAdapter<T>()).'],
	['IBeaconAuthenticationProvider', 'user store', 'Check passwords somewhere else.'],
	['IBeaconAuthorizationProvider', 'user store / allow-all', 'Cap users’ global read/write from your own model.'],
	['IProjectMembershipSource', 'Beacon’s membership table', 'Take project membership from your application.'],
	['IMcpCallerMapper', 'Beacon:Mcp:Callers', 'Map JWT callers to projects and scopes your own way.'],
	['IMcpHostPrincipalFactory', 'copies name, email, oid', 'Build the principal your endpoints expect for MCP calls.'],
	['IHostEndpointDispatchMiddleware', 'none', 'Run tenant, culture or audit logic around dispatched tool calls.'],
	['IApprovalNotifier', 'SignalR', 'Notify approvers elsewhere.'],
	['IBeaconUserContext', 'HttpContextUserContext', 'Resolve the current user differently.'],
];
---

<ExploreLayout
	area="extending"
	eyebrow="Explore · Extending your app"
	title="Teach Beacon <em>your</em> application."
	lede="An embedded Beacon can know your application, not only your databases. Expose your EF Core model as a read-only data source, import your Markdown docs as grounding, and turn selected HTTP endpoints into MCP tools. All three are opt-in and land in one host project."
	facts={[
		{ value: '3', label: 'host extensions' },
		{ value: '1', label: 'startup sync call' },
		{ value: '0', label: 'host connection strings stored' },
	]}
	deeper={[
		{ title: 'Host DbContext', href: '/mcp/host-dbcontext/', desc: 'Allow-lists, exclusions, masking and the execution-time policy.' },
		{ title: 'Host docs', href: '/mcp/host-docs/', desc: 'Shipping, importing and searching your Markdown documentation.' },
		{ title: 'Host endpoint tools', href: '/mcp/host-endpoint-tools/', desc: 'Exposure rules, dispatch, write tools, audit and limits.' },
	]}
>
	<div slot="hero" class="plug" role="img" aria-label="Your application exposes its DbContext, its Markdown docs and its HTTP endpoints to Beacon. Beacon serves them to an AI assistant as a read-only data source, imported documents and MCP tools.">
		<div class="plugBox app">
			<div class="plugHead"><span>Your application</span><span class="mono">Shop</span></div>
			<div class="ports">
				<div class="port">
					<span class="portIcon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="7" ry="3" /><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6" /><path d="M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3" /></svg></span>
					<b>ShopDbContext</b><span>EF Core model</span><code class="portApi">ExposeDbContext</code>
				</div>
				<div class="port">
					<span class="portIcon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></svg></span>
					<b>docs/*.md</b><span>Markdown docs</span><code class="portApi">ExposeDocs</code>
				</div>
				<div class="port">
					<span class="portIcon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5" /></svg></span>
					<b>/api/orders/{'{'}id{'}'}</b><span>HTTP endpoints</span><code class="portApi">AddHostEndpointTools</code>
				</div>
			</div>
		</div>
		<div class="wires" aria-hidden="true"><i style="--d:0s"></i><i style="--d:.5s"></i><i style="--d:1s"></i></div>
		<div class="plugBox beacon">
			<div class="plugHead"><span><span class="beaconDot"></span>Beacon</span><span class="mono">host project · Shop</span></div>
			<div class="outs">
				<div class="out">
					<small>Read-only data source</small>
					<span class="mono">dbo.Orders</span>
					<span class="mono">dbo.Customers</span>
					<span class="mono masked">Email ***</span>
				</div>
				<div class="out">
					<small>Imported documents</small>
					<span class="mono tag">[IMPORTED_DOC]</span>
					<span class="mono">orders/statuses.md</span>
					<span class="mono">support/…</span>
				</div>
				<div class="out">
					<small>MCP tools</small>
					<span class="mono tool">api_order_by_id</span>
					<span class="mono tool">api_customer_orders</span>
				</div>
			</div>
			<div class="gateStrip"><span>SQL gate (data source)</span><span>Project access</span><span>Audit</span></div>
		</div>
		<div class="wires one" aria-hidden="true"><i style="--d:1.4s"></i></div>
		<div class="plugBox assistant">
			<div class="plugHead"><span>AI assistant</span><span class="mono">tools/list</span></div>
			<div class="toolList">
				<span>get_context</span><span>search</span><span>get_documentation</span><span>query</span><span>…</span><span class="hl">api_order_by_id</span><span class="hl">api_customer_orders</span>
			</div>
		</div>
	</div>

	<Section num="01" label="Your DbContext as a data source" title="Your EF Core model, read-only, with a default-deny allow-list." lede="ExposeDbContext turns the model you already have into a Beacon data source. Metadata comes from the model without opening a connection, only allow-listed tables are visible, and the policy is checked again on every statement.">
		<div class="cols2">
			<div class="stack">
				<Code code={DBCONTEXT} lang="csharp" title="Program.cs" />
				<div class="connCard card">
					<div class="connRow">
						<span class="connKey">Stored</span>
						<code class="connVal">{'{'}"hostConnectionStringName":"ShopReadOnly"{'}'}</code>
					</div>
					<div class="connRow">
						<span class="connKey">Not stored</span>
						<span class="connVal struck mono">Server=sql.acme.example;User Id=beacon_ro;Password=…</span>
					</div>
					<p>Beacon keeps only the encrypted name of the connection string. The real string is read from configuration whenever a connection is opened, and should belong to a login that can only <code>SELECT</code> the allow-listed tables.</p>
				</div>
			</div>
			<div class="stack">
				<div class="mock">
					<div class="mockBar"><span>DATA SOURCE · SHOPDBCONTEXT</span><span class="badge neutral">Host-managed, read-only</span></div>
					<div class="mockBody">
						<div class="tblList">
							<div class="tbl on"><span class="mono">dbo.Orders</span><span>AllowTables</span></div>
							<div class="tbl on"><span class="mono">dbo.OrderLines</span><span>AllowTables</span></div>
							<div class="tbl on"><span class="mono">dbo.Customers</span><span>AllowTables</span></div>
							<div class="tbl on"><span class="mono">dbo.Products</span><span>AllowEntity&lt;Product&gt;</span></div>
							<div class="tbl off"><span class="mono">dbo.AuditLog</span><span>not allow-listed: invisible</span></div>
						</div>
						<div class="colHead">Columns of <span class="mono">dbo.Customers</span></div>
						<div class="cols">
							<div class="colRow"><span class="mono">Id</span><span class="colType">int, PK</span><span class="badge ok">Exposed</span></div>
							<div class="colRow"><span class="mono">Name</span><span class="colType">nvarchar(200)</span><span class="badge ok">Exposed</span></div>
							<div class="colRow"><span class="mono">Email</span><span class="colType">nvarchar(320)</span><span class="badge warn">Masked</span></div>
							<div class="colRow"><span class="mono">Phone</span><span class="colType">nvarchar(40)</span><span class="badge warn">Masked</span></div>
							<div class="colRow gone"><span class="mono">Notes</span><span class="colType">ExcludeColumns</span><span class="badge crit">Excluded</span></div>
							<div class="colRow gone"><span class="mono">PasswordHash</span><span class="colType">secret-like name</span><span class="badge crit">Excluded (secret-like name)</span></div>
						</div>
						<p class="note">Masked columns stay visible to the assistant, flagged <span class="mono">[PII: values are masked in query results]</span>. Names that look like secrets (<span class="mono">password</span>, <span class="mono">token</span>, <span class="mono">hash</span>, <span class="mono">otp</span> …) are excluded unless lifted with <span class="mono">IncludeSecretLikeColumn</span>.</p>
					</div>
				</div>
			</div>
		</div>

		<h3 class="subHead">Every statement is checked against the exposed slice</h3>
		<p class="subLede">The check runs in the execution gate and again in the database provider, in the data source's own dialect. Choose a statement to see what the host policy decides.</p>
		<div class="checker mock" data-checker>
			<div class="checkTabs" role="tablist" aria-label="Example statements">
				{
					CHECKS.map((c, i) => (
						<button type="button" role="tab" id={`chk-tab-${c.id}`} aria-controls={`chk-pane-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
							{c.label}
						</button>
					))
				}
			</div>
			{
				CHECKS.map((c, i) => (
					<div class="checkPane" role="tabpanel" id={`chk-pane-${c.id}`} aria-labelledby={`chk-tab-${c.id}`} hidden={i !== 0}>
						<pre class="checkSql">{c.sql}</pre>
						<div class="checkVerdict">
							<span class={`badge ${c.tone}`}>{c.verdict}</span>
							<p>{c.detail}</p>
							{c.rows && (
								<table class="mockTable">
									<thead>
										<tr><th>Id</th><th>Name</th><th>Email</th></tr>
									</thead>
									<tbody>
										<tr><td class="mono">11904</td><td>Ivan Kovač</td><td class="mono maskedVal">***</td></tr>
									</tbody>
								</table>
							)}
						</div>
					</div>
				))
			}
		</div>
		<p class="note">Host-masked values come back as <span class="mono">***</span> in every result (<span class="mono">NULL</span> stays <span class="mono">NULL</span>), masked by output position whatever the column is called. SQL Server and PostgreSQL models are supported.</p>
	</Section>

	<Section num="02" label="Your docs as grounding" title="Your Markdown documentation, searchable by every assistant." alt lede="ExposeDocs imports the documents you ship with the application into the host project. They are chunked for keyword search at once, embedded when semantic retrieval is on, and visible only to callers authorized for that project.">
		<div class="cols2">
			<div class="stack">
				<Code code={DOCS} lang="csharp" title="Program.cs, on the same builder" />
				<div class="mock">
					<div class="mockBar"><span>DOCS/</span><span>at startup</span></div>
					<div class="mockBody tree">
						<div class="tDir">orders/</div>
						<div class="tFile in"><span class="mono">statuses.md</span><span class="badge ok">Imported</span></div>
						<div class="tFile in"><span class="mono">refunds.md</span><span class="badge ok">Imported</span></div>
						<div class="tDir">support/</div>
						<div class="tFile in"><span class="mono">escalation.md</span><span class="badge ok">Imported</span></div>
						<div class="tDir">drafts/</div>
						<div class="tFile out"><span class="mono">returns-v2.md</span><span class="badge neutral">Exclude("drafts/**")</span></div>
						<div class="tDir">exports/</div>
						<div class="tFile out"><span class="mono">full-catalogue.md · 2.1 MB</span><span class="badge warn">Over MaxDocumentBytes</span></div>
					</div>
				</div>
			</div>
			<div class="stack">
				<Terminal label="MCP · search and get_documentation" html={SEARCH_HTML} />
				<div class="cols2 tight">
					<div class="card mini">
						<h3>Idempotent</h3>
						<p>An unchanged document is left alone. A changed one is updated in place, a removed file is archived, a returning file is restored.</p>
					</div>
					<div class="card mini">
						<h3>No LLM needed</h3>
						<p>Keyword search works with <code>UseAI = false</code>. Title comes from the frontmatter, the first heading or the file name.</p>
					</div>
				</div>
				<p class="note">Only <span class="mono">.md</span>, <span class="mono">.markdown</span> and <span class="mono">.txt</span> files are ingested. <span class="mono">get_context</span> with <span class="mono">format: "agents_md"</span> lists the imported titles in its project brief.</p>
			</div>
		</div>
	</Section>

	<Section num="03" label="Your endpoints as MCP tools" title="Endpoints you mark become tools, called through your own pipeline." lede="AddHostEndpointTools turns the endpoints you mark into MCP tools named api_<name>. Each call runs in-process through the endpoint's model binding, filters and authorization policies, as a host identity built for the MCP caller.">
		<div class="toolPath">
			<div class="stack">
				<Code code={ENDPOINT} lang="csharp" title="Minimal API" />
				<Code code={CONTROLLER} lang="csharp" title="Or a controller action" />
			</div>
			<div class="pathArrow" aria-hidden="true"><span>becomes</span></div>
			<div class="mock toolCard">
				<div class="mockBar"><span>MCP TOOL</span><span class="badge ok">read-only</span></div>
				<div class="mockBody">
					<div class="toolName mono">api_order_by_id</div>
					<p class="toolDesc">One order by id.</p>
					<dl class="toolMeta">
						<dt>Route</dt><dd class="mono">GET /api/orders/{'{'}id:int{'}'}</dd>
						<dt>Argument</dt><dd><span class="mono">id</span> · route value, required</dd>
						<dt>Policy</dt><dd class="mono">ViewOrders</dd>
						<dt>Project</dt><dd>Shop (host project)</dd>
					</dl>
					<div class="hints">
						<span class="mono">readOnlyHint: true</span>
						<span class="mono">destructiveHint: false</span>
						<span class="mono">idempotentHint: true</span>
						<span class="mono">openWorldHint: false</span>
					</div>
				</div>
			</div>
		</div>

		<h3 class="subHead">How a call is dispatched</h3>
		<div class="flowWrap">
		<Flow
			seconds={7}
			steps={[
				{ label: 'Check the caller', detail: 'A mapped Entra caller of the host project, with valid arguments.' },
				{ label: 'Build a principal', detail: 'IMcpHostPrincipalFactory builds the host identity for the caller.' },
				{ label: 'New request', detail: 'A new DI scope and HttpContext. No Authorization header or cookies are forwarded.' },
				{ label: 'Authorize', detail: 'The endpoint’s own policy, evaluated against the host principal.' },
				{ label: 'Run the endpoint', detail: 'Dispatch middleware, then binding, filters and the result.' },
				{ label: 'Capture and audit', detail: 'The response, capped at MaxResponseBytes, audited as api_<name>.', tone: 'ok' },
			]}
		/>
		</div>

		<div class="cols3 rules">
			<div class="card">
				<div class="cardIcon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l2.5 2.5L16 9" /><circle cx="12" cy="12" r="9" /></svg></div>
				<h3>ReadOnly is declared</h3>
				<p>Every tool states <code>ReadOnly</code>. Beacon never infers it from the HTTP verb, because back offices read over POST. A missing flag fails startup.</p>
			</div>
			<div class="card">
				<div class="cardIcon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10.5" width="16" height="10" rx="2" /><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5" /></svg></div>
				<h3>Authorization metadata required</h3>
				<p><code>[Authorize]</code>, a policy or <code>[AllowAnonymous]</code>, or a host fallback policy. Otherwise startup refuses the endpoint. A permission filter is not metadata.</p>
			</div>
			<div class="card">
				<div class="cardIcon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5" /><path d="M5 20c0-3.6 3.1-6 7-6s7 2.4 7 6" /></svg></div>
				<h3>Entra callers only</h3>
				<p>Only mapped Entra callers (users or systems) of the host project that may read it see or call the tools. API-key callers cannot.</p>
			</div>
			<div class="card">
				<div class="cardIcon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4v5c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V7l8-4z" /></svg></div>
				<h3>Runs as a host principal</h3>
				<p>The default factory gives a user no host permissions and never copies Entra roles or groups. Map users to your permissions in your own <code>IMcpHostPrincipalFactory</code>.</p>
			</div>
			<div class="card">
				<div class="cardIcon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9l-4-4L4 16v4z" /><path d="M13.5 6.5l4 4" /></svg></div>
				<h3>Write tools are opt-in</h3>
				<p><code>ReadOnly = false</code> needs <code>AllowWriteTools</code>, is offered to user callers only, carries <code>readOnlyHint = false</code> so clients ask first, and is audited as <code>api_&lt;name&gt;:write</code>.</p>
			</div>
			<div class="card">
				<div class="cardIcon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h9" /></svg></div>
				<h3>A catalog above 20 tools</h3>
				<p>Up to <code>NamedToolLimit</code> (20), each endpoint is its own tool. Above it, clients get <code>search_api</code> and <code>call_api</code> instead.</p>
			</div>
		</div>

		<div class="catalog">
			<div class="mock">
				<div class="mockBar"><span>12 ENDPOINTS</span><span>named tools</span></div>
				<div class="mockBody catList">
					<span>api_order_by_id</span><span>api_customer_orders</span><span>api_refund_by_id</span><span>api_shipment_status</span><span class="more">+ 8 more</span>
				</div>
			</div>
			<div class="mock">
				<div class="mockBar"><span>34 ENDPOINTS</span><span>catalog</span></div>
