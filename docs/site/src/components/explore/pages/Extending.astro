						<pre class="callIo"><span class="ioLabel">arguments</span>{'{'} "id": 104236 {'}'}
<span class="ioLabel">result</span>{'{'} "id": 104236, "status": "Shipped",
  "customerId": 11904, "total": 48.50,
  "placedAt": "2026-10-12T09:14:00Z" {'}'}</pre>
					</div>

					<div class="call" data-step="2">
						<div class="callHead"><span class="callTool mono">query</span><span class="badge ok">1 row</span></div>
						<pre class="callIo"><span class="ioLabel">datasource_name</span>ShopDbContext
<span class="ioLabel">sql</span>SELECT c.Id, c.Name, c.Email, c.Phone
FROM dbo.Customers c
WHERE c.Id = 11904</pre>
						<table class="mockTable">
