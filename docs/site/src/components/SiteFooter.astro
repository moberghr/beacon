---
// The dark Moberg footer shared by the landing page and the Explore pages.
import beaconLogo from '../assets/beacon-logo.svg';
import { AREAS } from './explore/areas';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const repo = 'https://github.com/moberghr/beacon';
---

<footer class="siteFooter">
	<div class="footWrap footerInner">
		<div class="footerBrand">
			<img src={beaconLogo.src} alt="Beacon" height="26" />
			<p>Database monitoring, alerting and data movement for .NET, with a governed MCP server for AI assistants.</p>
			<p class="tagline">A Moberg product · <em>Serious engineering, infinite possibilities.</em></p>
		</div>
		<div class="footerCols">
			<div>
				<h4>Explore</h4>
				{AREAS.slice(0, 4).map((a) => <a href={href(`/explore/${a.slug}/`)}>{a.label}</a>)}
			</div>
			<div>
				<h4>&nbsp;</h4>
				{AREAS.slice(4).map((a) => <a href={href(`/explore/${a.slug}/`)}>{a.label}</a>)}
			</div>
			<div>
				<h4>Start</h4>
				<a href={href('/getting-started/')}>Overview</a>
				<a href={href('/getting-started/quick-start/')}>Quick start</a>
				<a href={href('/integrate/')}>Integration guide</a>
				<a href={href('/llms.txt')}>llms.txt</a>
			</div>
			<div>
				<h4>Project</h4>
				<a href={repo}>GitHub</a>
				<a href={`${repo}/issues`}>Issues</a>
				<a href={`${repo}/discussions`}>Discussions</a>
				<a href={`${repo}/blob/main/LICENSING.md`}>Licensing</a>
			</div>
		</div>
	</div>
	<div class="footWrap footerBottom">© 2026 Moberg d.o.o. · Dual-licensed AGPL-3.0 or commercial</div>
</footer>

<style>
	.siteFooter { background: #0e1218; color: rgba(255, 255, 255, 0.62); }
	.footWrap { max-width: 1160px; margin: 0 auto; padding: 0 24px; }
	.footerInner { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr); gap: 40px; padding-top: 52px; padding-bottom: 36px; }
	.footerBrand img { height: 30px; width: auto; margin-bottom: 16px; filter: brightness(0) invert(1); opacity: 0.92; }
	.footerBrand p { font-size: 14px; line-height: 1.6; margin: 0 0 10px; max-width: 420px; }
	.footerBrand .tagline { font-size: 12.5px; color: rgba(255, 255, 255, 0.5); }
	.footerBrand .tagline em { color: rgba(255, 255, 255, 0.72); }
	.footerCols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
	.footerCols h4 { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; color: rgba(255, 255, 255, 0.45); margin: 0 0 14px; }
	.footerCols a { display: block; font-size: 14px; color: rgba(255, 255, 255, 0.68); text-decoration: none; margin: 0 0 9px; }
	.footerCols a:hover { color: #fff; }
	.footerBottom { border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 20px; padding-bottom: 28px; font-size: 12px; color: rgba(255, 255, 255, 0.4); }
	@media (max-width: 860px) {
		.footerInner { grid-template-columns: minmax(0, 1fr); gap: 28px; }
		.footerCols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
</style>
