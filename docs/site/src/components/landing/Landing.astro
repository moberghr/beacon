---
// Beacon landing page. Moberg house brand (blue #430cda, Helvetica Neue Light H1, numbered
// sections, dark footer), light-first. The hero trace and the gate diagram show how every AI
// query is checked, bounded, masked and audited.
import { Image } from 'astro:assets';
import SiteFooter from '../SiteFooter.astro';
import homeDark from '../../assets/screenshots/home-dark.png';
import homeLight from '../../assets/screenshots/home-light.png';
import controlTower from '../../assets/screenshots/control-tower-dark.png';
import queryEditor from '../../assets/screenshots/query-editor-light.png';
import playground from '../../assets/screenshots/mcp-playground-dark.png';
import learning from '../../assets/screenshots/mcp-learning-dark.png';
import approvalReview from '../../assets/screenshots/approval-review-light.png';
import projects from '../../assets/screenshots/projects-light.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const repo = 'https://github.com/moberghr/beacon';
const site = 'https://moberghr.github.io/beacon';

// ── Hero: one MCP call, traced through Beacon ───────────────────────────
const TRACE = [
	{ k: 'caller', v: 'API key <b>sk-sem_9f3c…</b> · Execute · as its owner' },
	{ k: 'project', v: '<b>Sales Ops</b> · Query allowed · 2 sources' },
	{ k: 'grounding', v: 'M-Schema · 3 join paths · 2 examples' },
	{ k: 'sql gate', v: 'guardrail · AST (postgres) · cross-db · cap' },
	{ k: 'execute', v: '<b>READ ONLY</b> · one statement · timeout' },
	{ k: 'masking', v: 'customer_email → <b>c***m</b>' },
	{ k: 'audit', v: 'ask · 42 rows · 318 ms · signal #8812' },
];

// ── 01 · What Beacon does ───────────────────────────────────────────────
const JOBS = [
	{
		num: '01', name: 'Watch', tag: 'scheduled SQL', link: '/explore/monitoring/', more: 'Explore monitoring',
		desc: 'Scheduled, multi-step SQL checks detect broken business rules, data-quality issues and unhealthy databases. Steps can span engines and are joined in memory.',
		code: "SELECT count(*) FROM orders\nWHERE status = 'pending'\n  AND created < now() - '1 day';",
	},
	{
		num: '02', name: 'Alert', tag: 'multi-channel', link: '/explore/alerting/', more: 'Explore alerting',
		desc: 'Results are delivered by email with CSV or Excel attachments, Microsoft Teams, Slack, Jira or webhook. Destinations are restricted by policy, and tasks are opened and resolved automatically.',
		code: 'rows > 0  →  Teams + Email(csv)\n          →  open task\nrows = 0  →  resolve task',
	},
	{
		num: '03', name: 'Serve AI', tag: 'governed MCP', link: '/explore/ai-and-mcp/', more: 'Explore AI and MCP',
		desc: 'Claude, Cursor, VS Code and other MCP clients ask questions in natural language. Beacon grounds and validates the SQL, runs it read-only, masks sensitive values and records the call.',
		code: 'ask("Which orders have been\n     pending for over a day?")',
	},
	{
		num: '04', name: 'Move', tag: 'audited ETL', link: '/explore/data-movement/', more: 'Explore data movement',
		desc: 'Insert, Upsert and Truncate-Load jobs move data between engines. The feature is disabled by default, writes only to targets an Admin has designated, and can require a second approval.',
		code: 'orders (PostgreSQL)\n  → warehouse.orders (Upsert)',
	},
];

// ── 02 · The gate ───────────────────────────────────────────────────────
const GATE = [
	{ n: '1', name: 'Deployment locks', note: 'Read-only execution and PII detection are enforced by host configuration and apply to Admins as well.' },
	{ n: '2', name: 'Length & characters', note: 'Oversized SQL, control characters and Unicode non-characters are rejected first.' },
	{ n: '3', name: 'Guardrail', note: 'Write and DDL patterns are rejected after comments are removed by the dialect’s tokenizer.' },
	{ n: '4', name: 'AST validator', note: 'Statements are parsed in the data source’s dialect. An unknown dialect is rejected.' },
	{ n: '5', name: 'Cross-database rule', note: 'References to other databases, remote servers and files, USE and SET ROLE, and dynamic SQL are rejected.' },
	{ n: '6', name: 'Row cap', note: 'A row limit is written into the SQL. Larger results fail or are reported as truncated.' },
	{ n: '7', name: 'Read-only execution', note: 'PostgreSQL and MySQL run each statement in a READ ONLY transaction, one statement per batch.' },
	{ n: '8', name: 'Mask & audit', note: 'PII is masked fail-closed, and every call, including refusals, is written to the audit log.' },
];

const GOVERNANCE = [
	{
		icon: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M14 17.5h7M17.5 14v7"/>',
		title: 'Projects define access',
		desc: 'Data sources are available through the projects that link them. New projects are restricted, with the creator as project admin. Users outside a project receive a 404 response.',
		link: '/features/authorization/',
	},
	{
		icon: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c0-3.3 2.5-5.5 5.5-5.5s5.5 2.2 5.5 5.5"/><path d="M16 6.5h5M16 10.5h5M17.5 14.5h3.5"/>',
		title: 'Separation of duties',
		desc: 'Approver, Auditor, SecurityAdmin, UserAdmin, DataSourceAdmin and MigrationOperator divide the Admin role. None of these permissions grants access to project data.',
		link: '/features/authorization/',
	},
	{
		icon: '<path d="M9 11l2.5 2.5L16 9"/><circle cx="12" cy="12" r="9"/>',
		title: 'Four-eyes approvals',
		desc: 'When enabled, changes to queries, migration jobs, Custom SQL rules and notification destinations take effect only after a second person approves the exact content.',
		link: '/features/approvals/',
	},
	{
		icon: '<rect x="4" y="10.5" width="16" height="10" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>',
		title: 'Protected secrets',
		desc: 'Connection strings are encrypted with AES-256-GCM, API keys are stored as SHA-256 hashes and shown once, and Data Protection keys are encrypted at rest outside Development.',
		link: '/features/security-model/',
	},
	{
		icon: '<path d="M4 6h16M4 12h10M4 18h7"/><circle cx="18" cy="16" r="3"/><path d="M20.2 18.2L22 20"/>',
		title: 'Signed audit trail',
		desc: 'Sign-ins and changes to access, keys, data sources, settings and approvals are recorded as append-only, signed events that an Auditor verifies. Every MCP call is recorded too, with the statements it ran.',
		link: '/features/security-audit/',
	},
	{
		icon: '<path d="M12 3l8 4v5c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V7l8-4z"/><path d="M9.5 12h5"/>',
		title: 'Managed sessions',
		desc: 'Sessions are revalidated on the server, expire after 12 hours and end immediately when a user’s roles change. SSO sign-in can require MFA.',
		link: '/integrate/authentication/',
	},
];

// ── 03 · Integrate with Claude ──────────────────────────────────────────
const PROMPT = `Integrate Beacon into this ASP.NET Core app.
Read ${site}/llms-integrate.txt first and follow its checklist step by step.
Use PostgreSQL for Beacon's metadata database and our existing sign-in.
Ask me before every decision the guide marks as one.`;

const CLAUDE_SESSION = `<span class="k-dim">~/src/acme-portal</span> <span class="k-green">❯</span> claude
<span class="k-purple">✻</span> <span class="k-mute">Welcome to</span> <span class="k-blue">Claude Code</span>

<span class="k-green">&gt;</span> Integrate Beacon into this ASP.NET Core app. Read
  ${site}/llms-integrate.txt …

<span class="k-purple">●</span> Fetch(llms-integrate.txt)  <span class="k-dim">13 pages · integration checklist</span>
<span class="k-purple">●</span> Bash(dotnet add package Moberg.Beacon.Core.PostgreSql …)
<span class="k-purple">●</span> Update(Program.cs)  <span class="k-dim">AddBeaconServices · UsePostgreSql · MapBeaconApi</span>
<span class="k-purple">●</span> Write(Jobs/BeaconScheduler.cs)  <span class="k-dim">IBeaconScheduler on Warp</span>
<span class="k-purple">●</span> Bash(dotnet user-secrets set Beacon:EncryptionKey …)

<span class="k-yellow">?</span> Decision required: keep the existing OIDC provider, or enable
  Beacon's local login with a break-glass account?`;

// ── 04 · Product tour ───────────────────────────────────────────────────
const TOUR = [
	{ id: 'home', label: 'Home', caption: 'Home: an overview of activity and open issues across projects.', themed: true },
	{ id: 'tower', label: 'Control Tower', image: controlTower, caption: 'Control Tower: the health of every scheduled check, including owner and approval state.' },
	{ id: 'query', label: 'Query editor', image: queryEditor, caption: 'Query editor: SQL editing with a database explorer, typed {name} parameters and multi-step queries.' },
	{ id: 'approve', label: 'Approvals', image: approvalReview, caption: 'Approvals: a second person reviews each change before it takes effect.' },
	{ id: 'projects', label: 'Projects', image: projects, caption: 'Projects: members and linked data sources, restricted by default.' },
	{ id: 'play', label: 'MCP playground', image: playground, caption: 'MCP playground: run the MCP tools in the browser before connecting a client.' },
	{ id: 'learn', label: 'Learning loop', image: learning, caption: 'Learning: review learned patterns and documentation patches before they are promoted.' },
];

const MARQUEE = [
	'PostgreSQL', 'SQL Server', 'MySQL', 'BigQuery', 'Snowflake', 'Databricks', 'Azure Synapse',
	'CloudWatch', 'REST APIs', 'Claude', 'Cursor', 'VS Code', 'Microsoft Entra ID', 'OpenAI',
	'Azure OpenAI', 'AWS Bedrock', 'Email', 'Microsoft Teams', 'Slack', 'Jira', 'Webhooks',
];
const marqueeItems = [...MARQUEE, ...MARQUEE];
---

<main class="bx not-content">
	<!-- ── Hero ─────────────────────────────────────────────────────────── -->
	<section class="hero">
		<svg class="heroRings" viewBox="0 0 600 600" aria-hidden="true">
			<circle cx="300" cy="300" r="90" />
			<circle cx="300" cy="300" r="160" />
			<circle cx="300" cy="300" r="230" />
			<circle cx="300" cy="300" r="298" />
		</svg>
		<div class="wrap heroGrid">
			<div class="heroLeft">
				<div class="eyebrow"><span class="eyebrowDot"></span>Beacon by Moberg</div>
				<h1 class="heroTitle">Monitor your databases.<br />Give AI <em>governed</em> access.</h1>
				<p class="heroSub">
					Beacon runs scheduled SQL checks, notifies the right people and provides AI assistants
					with an MCP server in which every query is project-scoped, read-only, masked and audited.
					It runs as a standalone application or inside your ASP.NET Core host.
				</p>
				<div class="heroActions">
					<a class="btnPrimary" href={href('/integrate/')}>
						Integrate Beacon
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
					</a>
					<a class="btnSecondary" href={href('/getting-started/quick-start/')}>Run locally</a>
					<a class="btnGhost" href={repo}>
						<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.75 5.48.75 11.75c0 5 3.24 9.24 7.73 10.74.57.1.78-.25.78-.55v-1.93c-3.14.68-3.81-1.51-3.81-1.51-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.51-.29-5.15-1.25-5.15-5.57 0-1.23.44-2.23 1.16-3.02-.12-.29-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.64 0c2.15-1.45 3.1-1.15 3.1-1.15.61 1.55.23 2.69.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.33-2.64 5.28-5.16 5.56.4.35.76 1.04.76 2.1v3.11c0 .3.2.66.79.55 4.49-1.5 7.73-5.74 7.73-10.74C23.25 5.48 18.27.5 12 .5Z" /></svg>
						GitHub
					</a>
				</div>
				<ul class="heroStats">
					<li>.NET 10</li><li>9 engines</li><li>8 MCP tools</li><li>PostgreSQL or SQL Server</li><li>AGPL-3.0 or commercial</li>
				</ul>
			</div>
			<div class="heroRight">
				<div class="terminal trace" role="img" aria-label="An MCP ask call traced through Beacon: caller, project, grounding, SQL gate, read-only execution, masking and audit all pass, returning 42 rows.">
					<div class="terminalBar"><i></i><i></i><i></i><span class="terminalLabel">beacon · mcp trace</span></div>
					<div class="traceBody">
						<div class="traceAsk"><span class="k-purple">ask</span> <span class="k-yellow">"Which orders have been pending for over a day?"</span></div>
						{TRACE.map((row, i) => (
							<div class="traceRow" style={`--i:${i}`}>
								<span class="traceTick" aria-hidden="true">✓</span>
								<span class="traceKey">{row.k}</span>
								<span class="traceVal" set:html={row.v} />
							</div>
						))}
						<div class="traceDone" style={`--i:${TRACE.length}`}><span class="k-green">→</span> 42 rows returned to the client</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ── Marquee ─────────────────────────────────────────────────────── -->
	<div class="marqueeWrap">
		<div class="wrap marqueeInner">
			<span class="marqueeLabel">Works with</span>
			<div class="marqueeViewport">
				<div class="marqueeTrack">{marqueeItems.map((item) => <span>{item}</span>)}</div>
			</div>
		</div>
	</div>

	<!-- ── 01 · What Beacon does ───────────────────────────────────────── -->
	<section class="section">
		<div class="wrap">
			<div class="secHead"><span class="secNum">01</span>What Beacon does</div>
			<h2 class="h2">An operations layer for your data, your team and your AI assistants.</h2>
			<p class="lede">
				Beacon connects to PostgreSQL, SQL Server, MySQL, BigQuery, Snowflake, Databricks, Azure
				Synapse, CloudWatch and REST APIs. It monitors data, notifies people when a check fails,
				answers questions from AI assistants and, when enabled, moves data between systems.
			</p>
			<div class="grid4">
				{JOBS.map((j) => (
					<a class="card" href={href(j.link)}>
						<span class="cardNum">{j.num}</span>
						<h3 class="cardName">{j.name}</h3>
						<span class="badge">{j.tag}</span>
						<p class="cardDesc">{j.desc}</p>
						<div class="cardCode"><pre>{j.code}</pre></div>
						<span class="cardMore">{j.more} →</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ── 02 · Security and governance ────────────────────────────────────── -->
	<section class="section sectionAlt">
		<div class="wrap">
			<div class="secHead"><span class="secNum">02</span>Security and governance</div>
			<h2 class="h2">Every query passes through the same execution gate.</h2>
			<p class="lede">
				MCP tools, scheduled checks, previews, AI features and saved-query tools all execute SQL
				through a single gate, which rejects any statement it cannot verify and reports the reason.
			</p>
			<ol class="gate">
				{GATE.map((g) => (
					<li class="gateStep">
						<span class="gateNum">{g.n}</span>
						<span class="gateName">{g.name}</span>
						<span class="gateNote">{g.note}</span>
					</li>
				))}
			</ol>
			<p class="gateFoot">
				Database-level read-only enforcement is available on PostgreSQL and MySQL. On other engines, Beacon
				relies on the gate and a read-only login, and marks the data source accordingly.
				&nbsp;<a href={href('/explore/governance/')}>Explore security and governance →</a>
			</p>
			<div class="grid3 govGrid">
				{GOVERNANCE.map((f) => (
					<a class="feature" href={href(f.link)}>
						<div class="featureIcon">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
						</div>
						<h3 class="featureTitle">{f.title}</h3>
						<p class="featureText">{f.desc}</p>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ── 03 · Integrate with Claude ──────────────────────────────────── -->
	<section class="section">
		<div class="wrap">
			<div class="secHead"><span class="secNum">03</span>Integrate with Claude</div>
			<div class="claudeGrid">
				<div>
					<h2 class="h2">Let your coding agent perform the integration.</h2>
					<p class="lede">
						The integration guide is written for developers and coding agents alike. It provides an
						ordered checklist, every option with its default, and the decisions that require your input.
						It is also published as a single Markdown file that Claude Code can read in one request.
					</p>
					<div class="promptBox">
						<div class="promptHead">
							<span>Paste into Claude Code</span>
							<button type="button" class="copyBtn" data-copy-target="claude-prompt">Copy</button>
						</div>
						<pre id="claude-prompt">{PROMPT}</pre>
					</div>
					<div class="llmsLinks">
						<a href={href('/llms-integrate.txt')}><code>llms-integrate.txt</code><span>integration guide, one file</span></a>
						<a href={href('/llms.txt')}><code>llms.txt</code><span>index of every page</span></a>
						<a href={href('/llms-full.txt')}><code>llms-full.txt</code><span>the whole documentation</span></a>
					</div>
				</div>
				<div class="terminal">
					<div class="terminalBar"><i></i><i></i><i></i><span class="terminalLabel">terminal</span></div>
					<pre class="terminalPre" set:html={CLAUDE_SESSION} />
				</div>
			</div>
		</div>
	</section>

	<!-- ── 04 · The product ────────────────────────────────────────────── -->
	<section class="section sectionAlt">
		<div class="wrap">
			<div class="secHead"><span class="secNum">04</span>The product</div>
			<h2 class="h2">A complete interface for data owners.</h2>
			<p class="lede">
				A web application with light and dark themes for projects and members, data sources, the
				query editor, subscriptions, approvals, the Control Tower and the MCP playground.
			</p>
			<div class="tour" data-tour>
				<div class="tourTabs" role="tablist" aria-label="Product screenshots">
					{TOUR.map((t, i) => (
						<button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={t.id}>{t.label}</button>
					))}
				</div>
				{TOUR.map((t, i) => (
					<figure class="tourPanel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
						<div class="shotWrap">
							{t.themed ? (
								<>
									<Image src={homeLight} alt="Beacon home (light theme)" class="shot" data-theme-target="light" loading="eager" densities={[1, 2]} />
									<Image src={homeDark} alt="Beacon home (dark theme)" class="shot" data-theme-target="dark" loading="eager" densities={[1, 2]} />
								</>
							) : (
								<Image src={t.image!} alt={t.caption} class="shot" loading="lazy" densities={[1, 2]} />
							)}
						</div>
						<figcaption class="shotCaption">{t.caption}</figcaption>
					</figure>
				))}
			</div>
			<p class="shotNote">Screenshots use sample data from Beacon's built-in mock mode (<code>npm run dev:mock</code>).</p>
		</div>
	</section>

	<!-- ── 05 · Get started ────────────────────────────────────────────── -->
	<section class="section">
		<div class="wrap">
			<div class="secHead"><span class="secNum">05</span>Get started</div>
			<h2 class="h2">Two ways to start.</h2>
			<div class="paths">
				<a class="path" href={href('/getting-started/quick-start/')}>
					<span class="pathKicker">A · Run the sample host</span>
					<h3>Clone, configure two secrets and run.</h3>
					<p>The quickest way to evaluate Beacon with your own databases. The reference host includes every connector, Warp background jobs and the full interface.</p>
					<pre><span class="k-dim">$</span> git clone https://github.com/moberghr/beacon
<span class="k-dim">$</span> dotnet run --project src/Beacon.SampleProject</pre>
					<span class="pathCta">Quick start →</span>
				</a>
				<a class="path" href={href('/integrate/')}>
					<span class="pathKicker">B · Embed in your application</span>
					<h3>Use your own host, sign-in and job runner.</h3>
					<p>Add the NuGet packages, register Beacon in <code>Program.cs</code>, and keep your existing identity provider, scheduler and deployment.</p>
					<pre><span class="k-dim">$</span> dotnet add package Moberg.Beacon.Core.PostgreSql
<span class="k-dim">$</span> dotnet add package Moberg.Beacon.UI</pre>
					<span class="pathCta">Integration guide →</span>
				</a>
			</div>
		</div>
	</section>

	<!-- ── Callout ─────────────────────────────────────────────────────── -->
	<section class="section sectionAlt">
		<div class="wrap">
			<div class="callout">
				<h2>Governed data access for your team and your AI assistants.</h2>
				<p>
					Beacon is dual-licensed under the GNU AGPL v3.0 or a commercial licence without copyleft
					obligations. Moberg partners use it under a licence exception.
				</p>
				<div class="calloutActions">
					<a class="calloutBtnPrimary" href={href('/integrate/')}>Integrate Beacon</a>
					<a class="calloutBtnSecondary" href={`${repo}/blob/main/LICENSING.md`}>Licensing</a>
				</div>
			</div>
		</div>
	</section>

	<SiteFooter />
</main>

<script>
	// Product tour tabs (roving tabindex, arrow keys).
	for (const tour of document.querySelectorAll<HTMLElement>('[data-tour]')) {
		const tabs = [...tour.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const select = (tab: HTMLButtonElement) => {
			for (const other of tabs) {
				const selected = other === tab;
				other.setAttribute('aria-selected', String(selected));
				other.tabIndex = selected ? 0 : -1;
				const panel = tour.querySelector<HTMLElement>(`#${other.getAttribute('aria-controls')}`);
				if (panel) panel.hidden = !selected;
			}
		};
		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => select(tab));
			tab.addEventListener('keydown', (e) => {
				const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
				if (step) {
					const next = tabs[(i + step + tabs.length) % tabs.length];
					select(next);
					next.focus();
				}
			});
		});
	}

	// Copy buttons.
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-target]')) {
		button.addEventListener('click', async () => {
			const target = document.getElementById(button.dataset.copyTarget!);
			try {
				await navigator.clipboard.writeText(target?.textContent ?? '');
				button.textContent = 'Copied';
			} catch {
				button.textContent = 'Select and copy';
			}
			setTimeout(() => (button.textContent = 'Copy'), 2000);
		});
	}
</script>

<style>
	.bx { --maxw: 1160px; }
