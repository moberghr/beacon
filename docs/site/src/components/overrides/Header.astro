---
// Site header with a top navigation bar, so every page (including the landing and Explore pages, which have no
// sidebar) shows the main sections. Desktop: inline links with an Explore menu. Narrow screens: one "Menu" panel.
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { AREAS } from '../explore/areas';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const current = Astro.url.pathname.replace(base, '') || '/';

interface Item {
	label: string;
	path: string;
	match: (p: string) => boolean;
}
const ITEMS: Item[] = [
	{ label: 'Get started', path: '/getting-started/', match: (p) => p.startsWith('/getting-started/') && !p.startsWith('/getting-started/configuration') },
	{ label: 'Cookbooks', path: '/cookbooks/', match: (p) => p.startsWith('/cookbooks/') },
	{ label: 'MCP', path: '/mcp/', match: (p) => p.startsWith('/mcp/') },
	{ label: 'Integrate', path: '/integrate/', match: (p) => p.startsWith('/integrate/') },
	{ label: 'Features', path: '/features/', match: (p) => p.startsWith('/features/') },
	{ label: 'Security', path: '/security/', match: (p) => p.startsWith('/security/') },
	{ label: 'Reference', path: '/getting-started/configuration/', match: (p) => p.startsWith('/reference/') || p.startsWith('/getting-started/configuration') },
];
const exploreActive = current.startsWith('/explore/');
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>

	<nav class="topNav" aria-label="Main">
		<ul class="topLinks">
			<li>
				<details class="exploreMenu">
					<summary class:list={['topLink', { active: exploreActive }]}>
						Explore
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
					</summary>
					<div class="explorePanel">
						{
							AREAS.map((a) => (
								<a href={href(`/explore/${a.slug}/`)} aria-current={current === `/explore/${a.slug}/` ? 'page' : undefined}>
									<b>{a.label}</b>
									<span>{a.tagline}</span>
								</a>
							))
						}
					</div>
				</details>
			</li>
			{
				ITEMS.map((item) => (
					<li>
						<a class:list={['topLink', { active: item.match(current) }]} href={href(item.path)} aria-current={item.match(current) ? 'true' : undefined}>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<div class="sl-flex print:hidden searchWrap">
		{shouldRenderSearch && <Search />}
	</div>

	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
	</div>

	<details class="mobileMenu print:hidden">
		<summary aria-label="Open the site menu">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
			Menu
		</summary>
		<div class="mobilePanel">
			<p class="mobileHead">Sections</p>
			{ITEMS.map((item) => <a href={href(item.path)} class:list={{ active: item.match(current) }}>{item.label}</a>)}
			<p class="mobileHead">Explore</p>
			{AREAS.map((a) => <a href={href(`/explore/${a.slug}/`)} class:list={{ active: current === `/explore/${a.slug}/` }}>{a.label}</a>)}
		</div>
	</details>
</div>

<script>
	// Close an open menu when the reader clicks elsewhere or presses Escape.
	const menus = [...document.querySelectorAll<HTMLDetailsElement>('.exploreMenu, .mobileMenu')];
	document.addEventListener('click', (event) => {
		for (const menu of menus) {
			if (menu.open && !menu.contains(event.target as Node)) {
				menu.open = false;
			}
		}
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			for (const menu of menus) {
				menu.open = false;
			}
		}
	});
</script>

<style>
	.header {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		height: 100%;
	}
	.title-wrapper {
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
		flex-shrink: 0;
	}
	.topNav { flex: 1 1 auto; min-width: 0; }
	.topLinks { display: flex; align-items: center; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
	.topLinks li { margin: 0; position: relative; }
	.topLink {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.4rem 0.7rem;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		cursor: pointer;
		white-space: nowrap;
		transition: color 0.15s, background 0.15s;
	}
	.topLink:hover { color: var(--sl-color-accent); background: var(--sl-color-accent-low); }
	.topLink.active { color: var(--sl-color-accent); background: var(--sl-color-accent-low); }
	:global(:root[data-theme='dark']) .topLink.active,
	:global(:root[data-theme='dark']) .topLink:hover { color: var(--sl-color-accent-high); }

	.exploreMenu summary { list-style: none; }
	.exploreMenu summary::-webkit-details-marker { display: none; }
	.exploreMenu[open] summary svg { transform: rotate(180deg); }
	.explorePanel {
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 0;
		z-index: 100;
		width: 34rem;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.25rem;
		padding: 0.6rem;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 12px;
		background: var(--sl-color-bg-nav);
		box-shadow: 0 18px 40px -12px rgba(14, 10, 50, 0.25);
	}
	.explorePanel a { display: block; padding: 0.6rem 0.75rem; border-radius: 8px; text-decoration: none; }
	.explorePanel a:hover, .explorePanel a[aria-current='page'] { background: var(--sl-color-accent-low); }
	.explorePanel b { display: block; font-size: 0.9rem; font-weight: 600; color: var(--sl-color-white); }
	.explorePanel span { display: block; font-size: 0.78rem; color: var(--sl-color-gray-3); line-height: 1.4; margin-top: 2px; }

	.searchWrap { flex-shrink: 0; }
	.right-group, .social-icons { gap: 1rem; align-items: center; flex-shrink: 0; }
	.social-icons::after { content: ''; height: 2rem; border-inline-end: 1px solid var(--sl-color-gray-5); }

	.mobileMenu { display: none; position: relative; flex-shrink: 0; }
	.mobileMenu summary {
		list-style: none;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.7rem;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 8px;
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.mobileMenu summary::-webkit-details-marker { display: none; }
	.mobilePanel {
		position: absolute;
		right: 0;
		top: calc(100% + 0.5rem);
		z-index: 100;
		width: min(18rem, 86vw);
		max-height: 75vh;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		padding: 0.6rem;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 12px;
		background: var(--sl-color-bg-nav);
		box-shadow: 0 18px 40px -12px rgba(14, 10, 50, 0.25);
	}
	.mobileHead { margin: 0.5rem 0.6rem 0.25rem; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sl-color-gray-3); }
	.mobilePanel a { padding: 0.45rem 0.6rem; border-radius: 8px; font-size: 0.9rem; color: var(--sl-color-gray-1); text-decoration: none; }
	.mobilePanel a:hover, .mobilePanel a.active { background: var(--sl-color-accent-low); color: var(--sl-color-accent); }

	/* Narrow screens: the inline links give way to the Menu panel. On doc pages below 50rem Starlight's own sidebar
	   menu (hamburger) already lists every page, so the extra Menu button is hidden there. */
	@media (max-width: 50rem) {
		:global(:root[data-has-sidebar]) .mobileMenu { display: none !important; }
	}
	@media (max-width: 72rem) {
		.topNav { display: none; }
		.mobileMenu { display: block; }
		.header { justify-content: space-between; }
		.searchWrap { margin-left: auto; }
	}
</style>
